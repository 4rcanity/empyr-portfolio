# Cloudflare Worker hosts for the multiplayer minigames (no protocol prefix).
# Each game has its own worker, so each gets its own host and local port.

# HI/LO Frenzy — local: localhost:8787
PUBLIC_HILO_HOST=empyr-hilo.arcanearthenden.workers.dev

# EMPYR UNO — local: localhost:8788
PUBLIC_UNO_HOST=empyr-uno.arcanearthenden.workers.dev

# EMPYR LEDGER (Monopoly) — local: localhost:8789
PUBLIC_MONOPOLY_HOST=empyr-monopoly.arcanearthenden.workers.dev

# Help widget handoff (Web3Forms via server/help) — local: localhost:8790
# The access key is a worker secret, not a PUBLIC_ var.
PUBLIC_HELP_HOST=empyr-help.arcanearthenden.workers.dev

# LIAR'S BAR — local: localhost:8795