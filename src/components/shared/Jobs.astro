---
/**
 * Condensed version of the hiring announcement posted in the Discord —
 * stripped of the @everyone preamble and "what does this mean" filler, just
 * the roles, the pay, and a way to apply.
 */
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const nl = lang === 'nl';

const DISCORD_URL = 'https://discord.gg/sfnQdNPNg2';
const whatsAppMessage = nl
  ? 'Hoi Empyr! Ik wil solliciteren voor een rol bij Empyr Studios.'
  : "Hi Empyr! I'd like to apply for a role at Empyr Studios.";
const WHATSAPP_URL = `https://wa.me/31638269872?text=${encodeURIComponent(whatsAppMessage)}`;

const roles = nl
  ? [
      {
        title: 'Webdesigners',
        pay: '€800 – €3.000 per website',
        req: 'Aantoonbare ervaring vereist. Portfolio of diploma is een plus.',
        badge: 'Ervaring vereist',
      },
      {
        title: 'App developers',
        pay: '€3.000 – €11.000+ per app',
        req: 'Windows, iOS en Android. Bedrag verdeeld over het team, afhankelijk van workload.',
        badge: 'Ervaring vereist',
      },
      {
        title: 'Pitchers / sales',
        pay: '€300 per klant + bonus',
        req: 'Lokale bedrijven zonder (goede) website vinden en overtuigen. Geen ervaring nodig.',
        badge: 'Geen ervaring nodig',
      },
    ]
  : [
      {
        title: 'Web designers',
        pay: '$800 – $3,000 per site',
        req: 'Proven experience required. A portfolio or degree helps your odds.',
        badge: 'Experience required',
      },
      {
        title: 'App developers',
        pay: '$3,000 – $11,000+ per app',
        req: 'Windows, iOS and Android. Split across the team depending on workload.',
        badge: 'Experience required',
      },
      {
        title: 'Pitchers / sales',
        pay: '$300 per customer + bonus',
        req: 'Find and close local businesses that need a website. No experience required.',
        badge: 'No experience needed',
      },
    ];

const copy = nl
  ? {
      eyebrow: 'Empyr Studios werft aan',
      title: "We're hiring, wereldwijd.",
      body: 'Remote, contractbasis. Betaald per project — geen "vibecoders" zonder code-ervaring.',
      bonusNote: '+ €1.000 bonus bij 10 nieuwe klanten in een maand.',
      applyDiscord: 'Solliciteer via Discord',
      applyWhatsApp: 'Solliciteer via WhatsApp',
    }
  : {
      eyebrow: 'Empyr Studios is hiring',
      title: "We're hiring, worldwide.",
      body: 'Remote, contract-based. Paid per project — no "vibecoders" without real coding experience.',
      bonusNote: '+ $1,000 bonus for 10 new customers in a month.',
      applyDiscord: 'Apply via Discord',
      applyWhatsApp: 'Apply via WhatsApp',
    };
---

<section id="jobs" class="scroll-mt-20 border-t border-white/10 bg-[#0c0a09] py-24 text-stone-100 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[0.24em] text-orange-400">{copy.eyebrow}</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-[-0.05em] sm:text-5xl">{copy.title}</h2>
      <p class="mt-5 text-base leading-7 text-stone-400">{copy.body}</p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      {
        roles.map((role) => (
          <div class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.04] p-6">
            <span class="w-fit rounded-full border border-orange-400/20 bg-orange-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-orange-300">
              {role.badge}
            </span>
            <h3 class="mt-5 text-lg font-bold text-white">{role.title}</h3>
            <p class="mt-1 text-xl font-bold tracking-tight text-orange-400">{role.pay}</p>
            <p class="mt-3 flex-1 text-sm leading-6 text-stone-400">{role.req}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-6 text-sm text-stone-500">{copy.bonusNote}</p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-[#5865F2] px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-[#5865F2]/25 transition hover:-translate-y-0.5 hover:bg-[#4752c4]"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c1.9938 1.4738 3.9256 2.3567 5.8306 2.9358a.0774.0774 0 0 0 .0842-.0276c.4535-.6193.8571-1.2721 1.204-1.9578a.0764.0764 0 0 0-.0417-.1057c-.6408-.2428-1.2504-.5406-1.8341-.8794a.0763.0763 0 0 1-.0076-.1267c.1235-.0926.247-.1888.3644-.2861a.0763.0763 0 0 1 .0785-.0104c3.8483 1.7595 8.0193 1.7595 11.8324 0a.0763.0763 0 0 1 .0788.0095c.1174.0973.2409.1945.3652.2861a.0763.0763 0 0 1-.0067.1268 12.299 12.299 0 0 1-1.8342.8788.0764.0764 0 0 0-.0416.1064c.3549.6853.7583 1.3376 1.203 1.9569a.0771.0771 0 0 0 .0842.0286c1.9109-.5788 3.8427-1.4617 5.8367-2.9364a.078.078 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286ZM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189Zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
        </svg>
        {copy.applyDiscord}
      </a>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-6 py-3.5 text-sm font-semibold text-white transition hover:border-[#25D366]/50 hover:bg-white/[0.08]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-[#25D366]" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.882 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {copy.applyWhatsApp}
      </a>
    </div>
  </div>
</section>
