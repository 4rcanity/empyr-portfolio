---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy =
  lang === 'nl'
    ? {
        eyebrow: 'Welkom bij Empyr',
        title: 'Wat wil je ontdekken?',
        subtitle: 'Kies een discipline en stap binnen in het werk.',
        webTitle: 'Webdesign',
        webBody: 'Snelle, onderscheidende websites die lokale merken vooruithelpen.',
        webCta: 'Bekijk webprojecten',
        gameTitle: 'Game development',
        gameBody: 'Interactieve werelden, prototypes en ervaringen. Binnenkort meer.',
        gameCta: 'Bekijk wat eraan komt',
        miniTitle: 'Minigames',
        miniBody: 'Korte, speelbare experimenten en browsergames. Spring er meteen in.',
        miniCta: 'Speel minigames',
        available: 'Beschikbaar',
        wip: 'In ontwikkeling',
        playable: 'Speelbaar',
        close: 'Sluiten',
      }
    : {
        eyebrow: 'Welcome to Empyr',
        title: 'What would you like to explore?',
        subtitle: 'Choose a discipline and step into the work.',
        webTitle: 'Web design',
        webBody: 'Fast, distinctive websites that move local brands forward.',
        webCta: 'Explore web projects',
        gameTitle: 'Game development',
        gameBody: 'Interactive worlds, prototypes and experiences. More soon.',
        gameCta: 'See what is coming',
        miniTitle: 'Minigames',
        miniBody: 'Short playable experiments and browser games. Jump straight in.',
        miniCta: 'Play minigames',
        available: 'Available',
        wip: 'In development',
        playable: 'Playable',
        close: 'Close',
      };
---

<div
  class="portfolio-gate fixed inset-0 z-[100] flex items-center justify-center overflow-y-auto bg-[#090909]/95 px-4 py-8 backdrop-blur-xl"
  data-portfolio-gate
  role="dialog"
  aria-modal="true"
  aria-labelledby="portfolio-gate-title"
>
  <div class="gate-orb gate-orb-one"></div>
  <div class="gate-orb gate-orb-two"></div>
  <div class="gate-orb gate-orb-three"></div>

  <div class="relative w-full max-w-6xl">
    <button
      type="button"
      class="absolute right-0 top-0 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/[0.06] text-stone-400 transition hover:border-white/25 hover:text-white"
      data-portfolio-close
      aria-label={copy.close}
    >
      <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"></path>
      </svg>
    </button>

    <div class="mb-8 text-center">
      <img
        src="/images/empyr-logo.png"
        alt=""
        class="mx-auto h-14 w-14 rounded-2xl object-cover shadow-2xl shadow-orange-500/20"
        width="56"
        height="56"
      />
      <p class="mt-5 text-xs font-bold uppercase tracking-[0.32em] text-orange-400">{copy.eyebrow}</p>
      <h2 id="portfolio-gate-title" class="mt-3 text-3xl font-semibold tracking-[-0.04em] text-white sm:text-5xl">
        {copy.title}
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-stone-400 sm:text-base">{copy.subtitle}</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <a
        href="#work"
        class="gate-card group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.06] p-7 text-left transition duration-500 hover:-translate-y-1 hover:border-orange-400/50 hover:bg-white/[0.09] sm:p-9"
        data-portfolio-choice="web"
      >
        <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-orange-500/20 blur-3xl transition duration-500 group-hover:bg-orange-500/30"></div>
        <div class="relative">
          <div class="flex items-center justify-between gap-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-500 text-white shadow-lg shadow-orange-500/20">
              <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="4" width="18" height="14" rx="2"></rect>
                <path d="M3 8h18M8 21h8M12 18v3"></path>
              </svg>
            </span>
            <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-emerald-300">
              {copy.available}
            </span>
          </div>
          <h3 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.webTitle}</h3>
          <p class="mt-3 max-w-sm text-sm leading-6 text-stone-400">{copy.webBody}</p>
          <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-orange-300">
            {copy.webCta}
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </div>
      </a>

      <a
        href={`/${lang}/games`}
        class="gate-card group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04] p-7 text-left transition duration-500 hover:-translate-y-1 hover:border-violet-400/50 hover:bg-white/[0.08] sm:p-9"
        data-portfolio-choice="games"
      >
        <div class="absolute -bottom-14 -right-12 h-48 w-48 rounded-full bg-violet-500/20 blur-3xl transition duration-500 group-hover:bg-violet-500/30"></div>
        <div class="relative">
          <div class="flex items-center justify-between gap-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-500 text-white shadow-lg shadow-violet-500/20">
              <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M8.5 8h7a5.5 5.5 0 0 1 5.24 7.18l-.76 2.37a2 2 0 0 1-3.16.96L14.8 17h-5.6l-2.02 1.51a2 2 0 0 1-3.16-.96l-.76-2.37A5.5 5.5 0 0 1 8.5 8Z"></path>
                <path d="M8 12v3M6.5 13.5h3M16.5 12.5h.01M18 14h.01M9 8l1-3h4l1 3"></path>
              </svg>
            </span>
            <span class="rounded-full border border-violet-400/20 bg-violet-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-violet-300">
              {copy.wip}
            </span>
          </div>
          <h3 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.gameTitle}</h3>
          <p class="mt-3 max-w-sm text-sm leading-6 text-stone-400">{copy.gameBody}</p>
          <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-violet-300">
            {copy.gameCta}
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </div>
      </a>

      <a
        href={`/${lang}/minigames`}
        class="gate-card group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04] p-7 text-left transition duration-500 hover:-translate-y-1 hover:border-cyan-400/50 hover:bg-white/[0.08] sm:p-9 md:col-span-2 xl:col-span-1"
        data-portfolio-choice="minigames"
      >
        <div class="absolute -bottom-14 -left-12 h-48 w-48 rounded-full bg-cyan-500/20 blur-3xl transition duration-500 group-hover:bg-cyan-500/30"></div>
        <div class="relative">
          <div class="flex items-center justify-between gap-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-500 text-white shadow-lg shadow-cyan-500/20">
              <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 3v2M12 19v2M3 12h2M19 12h2"></path>
              </svg>
            </span>
            <span class="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-cyan-300">
              {copy.playable}
            </span>
          </div>
          <h3 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.miniTitle}</h3>
          <p class="mt-3 max-w-sm text-sm leading-6 text-stone-400">{copy.miniBody}</p>
          <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-cyan-300">
            {copy.miniCta}
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var gate = document.querySelector('[data-portfolio-gate]');
    if (!gate) return;

    var KEY = 'empyr-portfolio-choice';
    var lastTrigger = null;
    var closeTimer = 0;

    function read() {
      try {
        return sessionStorage.getItem(KEY);
      } catch (e) {
        return null;
      }
    }

    function write(choice) {
      try {
        sessionStorage.setItem(KEY, choice || 'web');
      } catch (e) {}
    }

    function open() {
      window.clearTimeout(closeTimer);
      gate.hidden = false;
      gate.classList.remove('is-leaving');
      // Restart the intro animation when the gate is summoned again.
      gate.classList.remove('portfolio-gate');
      void gate.offsetWidth;
      gate.classList.add('portfolio-gate');
      document.documentElement.style.overflow = 'hidden';
      var first = gate.querySelector('[data-portfolio-choice]');
      if (first) first.focus();
    }

    function close(choice) {
      write(choice || read() || 'web');
      document.documentElement.style.overflow = '';
      gate.classList.add('is-leaving');
      closeTimer = window.setTimeout(function () {
        gate.hidden = true;
        gate.classList.remove('is-leaving');
      }, 340);
      if (lastTrigger && lastTrigger.focus) lastTrigger.focus();
      lastTrigger = null;
    }

    var params = new URLSearchParams(location.search);
    var forced = params.get('chooser') === '1' || location.hash === '#explore';

    if (forced) {
      // Drop the trigger from the URL so a refresh does not re-open the gate.
      params.delete('chooser');
      var query = params.toString();
      var hash = location.hash === '#explore' ? '' : location.hash;
      history.replaceState(null, '', location.pathname + (query ? '?' + query : '') + hash);
      open();
    } else if (read()) {
      gate.hidden = true;
    } else {
      open();
    }

    gate.querySelectorAll('[data-portfolio-choice]').forEach(function (choice) {
      choice.addEventListener('click', function () {
        var value = choice.dataset.portfolioChoice || 'web';
        // Web stays on this page, so dismiss the gate; the others navigate away.
        if (value === 'web') close(value);
        else write(value);
      });
    });

    var closeBtn = gate.querySelector('[data-portfolio-close]');
    if (closeBtn) closeBtn.addEventListener('click', function () { close(); });

    gate.addEventListener('mousedown', function (event) {
      if (event.target === gate) close();
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !gate.hidden) close();
    });

    // Delegated: this script runs before the header further down the page exists.
    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!(target instanceof Element)) return;
      var trigger = target.closest('[data-portfolio-open]');
      if (!trigger) return;
      event.preventDefault();
      lastTrigger = trigger;
      open();
    });
  })();
</script>

<style>
  /* Tailwind's display utilities outrank the UA [hidden] rule. */
  [data-portfolio-gate][hidden] {
    display: none !important;
  }

  .portfolio-gate {
    animation: gate-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .portfolio-gate.is-leaving {
    animation: gate-out 340ms ease both;
    pointer-events: none;
  }

  .gate-card {
    animation: card-in 600ms 120ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .gate-card + .gate-card {
    animation-delay: 190ms;
  }

  .gate-card + .gate-card + .gate-card {
    animation-delay: 260ms;
  }

  .gate-orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(80px);
    pointer-events: none;
  }

  .gate-orb-one {
    top: -8rem;
    left: -5rem;
    width: 22rem;
    height: 22rem;
    background: rgb(249 115 22 / 0.12);
  }

  .gate-orb-two {
    right: -6rem;
    bottom: -8rem;
    width: 24rem;
    height: 24rem;
    background: rgb(139 92 246 / 0.1);
  }

  .gate-orb-three {
    left: 35%;
    top: 40%;
    width: 18rem;
    height: 18rem;
    background: rgb(34 211 238 / 0.08);
  }

  @keyframes gate-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes gate-out {
    to { opacity: 0; transform: scale(1.015); }
  }

  @keyframes card-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-gate,
    .portfolio-gate.is-leaving,
    .gate-card {
      animation: none;
    }
  }
</style>
