---
/**
 * Studio switcher — toggles between the two Empyr "windows":
 * the Portfolio site and the Minigames arcade. Rendered in the header
 * of both worlds; whichever world you're in is highlighted.
 */
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  current: 'portfolio' | 'minigames';
}

const { lang, current } = Astro.props;

const items = [
  {
    id: 'portfolio',
    label: 'Portfolio',
    href: `/${lang}/`,
    icon: 'M4 5h16v11H4z M4 20h16 M9 20v-4h6v4',
  },
  {
    id: 'minigames',
    label: 'Minigames',
    href: `/${lang}/minigames`,
    icon: 'M6 12h4m-2-2v4m7-3h.01M18 13h.01M17.3 5H6.7a4 4 0 0 0-4 3.6C2.3 11.5 2 15.7 2.6 17.4c.4 1.2 1.6 1.9 2.8 1.4 1-.4 1.9-1.3 2.6-2.3h8c.7 1 1.6 1.9 2.6 2.3 1.2.5 2.4-.2 2.8-1.4.6-1.7.3-5.9-.1-8.8a4 4 0 0 0-4-3.6Z',
  },
] as const;
---

<div
  class="flex items-center gap-1 rounded-full border border-white/10 bg-white/[0.04] p-1 text-xs font-semibold"
  role="group"
  aria-label="Studio"
>
  {
    items.map((item) => (
      <a
        href={item.href}
        class:list={[
          'flex items-center gap-1.5 rounded-full px-3 py-1.5 transition-colors',
          current === item.id ? 'bg-white text-stone-900' : 'text-stone-400 hover:text-white',
        ]}
        aria-current={current === item.id ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
          <path d={item.icon} />
        </svg>
        {item.label}
      </a>
    ))
  }
</div>
