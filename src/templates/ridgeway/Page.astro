---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../components/shared/LanguageSwitcher.astro';
import Footer from '../../components/shared/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const telHref = `tel:${config.phone.replace(/\s/g, '')}`;
const whatsappHref =
  config.reservationUrl?.startsWith('https://wa.me/')
    ? config.reservationUrl
    : `https://wa.me/${config.phone.replace(/\D/g, '')}`;
const rail = [config.heroImage, config.aboutImage, ...config.gallery].filter(Boolean) as string[];
let serviceIndex = 0;
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="rw" data-archetype="editorial-magazine">
    <header class="rw-masthead">
      <a class="rw-brand" href={`/${lang}/${config.slug}`}>{config.name}</a>
      <nav class="rw-nav" aria-label="Primary">
        <a href="#story">{content.about.heading}</a>
        <a href="#services">{content.menuSectionLabel ?? t('menu.title')}</a>
        <a href="#visit">{t('nav.contact')}</a>
      </nav>
      <LanguageSwitcher lang={lang} slug={config.slug} variant="dark" />
    </header>

    <section class="rw-cover">
      <div class="rw-cover-copy">
        <p class="rw-issue">{config.address.city} · {config.address.postalCode}</p>
        <h1>{content.tagline}</h1>
        <p class="rw-deck">{content.description}</p>
        <div class="rw-cta">
          <a href={telHref}>{t('cta.callNow')}</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      </div>
      <div class="rw-cover-stack" aria-hidden="true">
        <img class="rw-cut rw-cut-a" src={rail[0]} alt="" />
        <img class="rw-cut rw-cut-b" src={rail[1] ?? rail[0]} alt="" />
        <img class="rw-cut rw-cut-c" src={rail[2] ?? rail[0]} alt="" />
      </div>
    </section>

    <section class="rw-story" id="story">
      <div class="rw-story-col">
        <h2>{content.about.heading}</h2>
        <p>{content.about.content}</p>
        {content.bookingNote && <p class="rw-aside">{content.bookingNote}</p>}
      </div>
      <aside class="rw-rail" aria-label={t('gallery.title')}>
        {rail.slice(0, 5).map((src) => (
          <img src={src} alt="" loading="lazy" />
        ))}
      </aside>
    </section>

    <section class="rw-services" id="services">
      <header class="rw-services-head">
        <h2>{content.menuSectionLabel ?? t('menu.title')}</h2>
        <p>{config.phone}</p>
      </header>
      {content.menu.map((cat) => (
        <div class="rw-service-block">
          <h3>{cat.name}</h3>
          <ol>
            {cat.items.map((item) => {
              serviceIndex += 1;
              const n = String(serviceIndex).padStart(2, '0');
              return (
                <li>
                  <span class="rw-num">{n}</span>
                  <div>
                    <strong>{item.name}</strong>
                    <p>{item.description}</p>
                  </div>
                  <em>{item.price}</em>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </section>

    <section class="rw-visit" id="visit">
      <div>
        <h2>{t('contact.visitUs')}</h2>
        <p>
          {config.address.street}<br />
          {config.address.postalCode} {config.address.city}
        </p>
        <ul>
          {content.openingHours.map((hour) => {
            const row = formatOpeningHours(t, hour);
            return (
              <li>
                <span>{row.label}</span>
                <span>{row.value}</span>
              </li>
            );
          })}
        </ul>
        <div class="rw-cta">
          <a href={telHref}>{t('cta.callNow')}</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      </div>
      <iframe
        title={`${config.name} map`}
        src={config.googleMapsEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </section>

    <Footer config={config} lang={lang} />
  </div>
</BaseLayout>

<style>
  .rw {
    overflow-x: clip;
  }

  .rw-masthead {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--color-background) 92%, transparent);
    backdrop-filter: blur(10px);
  }

  .rw-brand {
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 700;
    white-space: nowrap;
  }

  .rw-nav {
    display: none;
    gap: 1.25rem;
    margin-right: auto;
    margin-left: 1.5rem;
  }

  @media (min-width: 760px) {
    .rw-nav { display: flex; }
  }

  .rw-nav a {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .rw-nav a:hover { color: var(--color-accent); }

  .rw-cover {
    display: grid;
    gap: 2rem;
    padding: 2rem 1.25rem 3rem;
    max-width: 78rem;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .rw-cover {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: end;
      min-height: min(88vh, 820px);
      padding-top: 3rem;
    }
  }

  .rw-issue {
    margin: 0;
    color: var(--color-accent);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .rw-cover h1 {
    margin: 0.75rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 8vw, 5.6rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    max-width: 11ch;
  }

  .rw-deck {
    margin: 1.1rem 0 0;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.55;
    max-width: 34ch;
  }

  .rw-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .rw-cta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.85rem;
    padding: 0.7rem 1.15rem;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.86rem;
  }

  .rw-cta a:last-child {
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-text) 35%, transparent);
    color: var(--color-text);
  }

  .rw-cover-stack {
    position: relative;
    min-height: 280px;
  }

  .rw-cut {
    position: absolute;
    object-fit: cover;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .rw-cut-a {
    width: 72%;
    aspect-ratio: 4 / 5;
    top: 0;
    left: 0;
    z-index: 1;
    border-radius: 0 2.5rem 0 2.5rem;
  }

  .rw-cut-b {
    width: 48%;
    aspect-ratio: 1;
    right: 0;
    top: 12%;
    z-index: 2;
    border-radius: 50%;
  }

  .rw-cut-c {
    width: 42%;
    aspect-ratio: 5 / 4;
    right: 8%;
    bottom: 0;
    z-index: 3;
    border-radius: 1.5rem 0;
  }

  .rw-story {
    display: grid;
    gap: 1.5rem;
    padding: 0 0 3rem;
    max-width: 78rem;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .rw-story {
      grid-template-columns: minmax(0, 1fr) 14rem;
      padding-left: 1.25rem;
      align-items: start;
    }
  }

  .rw-story-col {
    padding: 0 1.25rem;
    max-width: 42rem;
  }

  .rw-story h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .rw-story-col > p {
    margin: 1rem 0 0;
    font-size: 1.08rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-text) 88%, transparent);
  }

  .rw-aside {
    margin-top: 1.25rem !important;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted) !important;
    font-size: 0.98rem !important;
  }

  .rw-rail {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding: 0 1.25rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  @media (min-width: 900px) {
    .rw-rail {
      position: sticky;
      top: 5rem;
      flex-direction: column;
      overflow-x: visible;
      overflow-y: auto;
      max-height: calc(100vh - 6rem);
      padding: 0 1.25rem 0 0;
      scroll-snap-type: y mandatory;
    }
  }

  .rw-rail img {
    flex: 0 0 auto;
    width: min(70vw, 260px);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    scroll-snap-align: start;
    border-radius: 0 1.25rem;
  }

  @media (min-width: 900px) {
    .rw-rail img {
      width: 100%;
    }
  }

  .rw-services {
    padding: 2.5rem 1.25rem 3rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
    max-width: 52rem;
    margin: 0 auto;
  }

  .rw-services-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .rw-services-head h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    text-transform: uppercase;
    line-height: 1;
  }

  .rw-services-head p {
    margin: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  .rw-service-block + .rw-service-block {
    margin-top: 2.25rem;
  }

  .rw-service-block h3 {
    margin: 0 0 0.85rem;
    color: var(--color-accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .rw-service-block ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rw-service-block li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: start;
    padding: 1rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .rw-num {
    font-family: var(--font-heading);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .rw-service-block strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .rw-service-block p {
    margin: 0.3rem 0 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .rw-service-block em {
    font-style: normal;
    color: var(--color-accent);
    font-weight: 700;
    white-space: nowrap;
  }

  .rw-visit {
    display: grid;
    gap: 1.5rem;
    padding: 0 1.25rem 3rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  @media (min-width: 800px) {
    .rw-visit {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: stretch;
    }
  }

  .rw-visit h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 2rem;
    text-transform: uppercase;
  }

  .rw-visit p {
    margin: 0.85rem 0 0;
    line-height: 1.55;
  }

  .rw-visit ul {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .rw-visit li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    font-size: 0.92rem;
  }

  .rw-visit iframe {
    width: 100%;
    min-height: 280px;
    border: 0;
    border-radius: 0 2rem 0 2rem;
  }
</style>
