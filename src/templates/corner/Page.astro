---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../components/shared/LanguageSwitcher.astro';
import Footer from '../../components/shared/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const telHref = `tel:${config.phone.replace(/\s/g, '')}`;
const orderHref = config.deliveryLinks?.[0]?.url ?? telHref;
const menuItems = content.menu.flatMap((cat) =>
  cat.items.map((item) => ({ ...item, category: cat.name }))
);
const ig = config.instagramFeed ?? config.gallery;
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="cr" data-archetype="asymmetric-bento">
    <header class="cr-top">
      <a href={`/${lang}/${config.slug}`}>{config.name}</a>
      <LanguageSwitcher lang={lang} slug={config.slug} />
    </header>

    <div class="cr-bento">
      <article class="cr-cell cr-hero">
        <img src={config.heroImage} alt="" />
        <div>
          <h1>{config.name}</h1>
          <p>{content.tagline}</p>
        </div>
      </article>

      {content.dailySpecial && (
        <article class="cr-cell cr-special">
          <p>Today</p>
          <h2>{content.dailySpecial}</h2>
        </article>
      )}

      <article class="cr-cell cr-story">
        <h2>{content.about.heading}</h2>
        <p>{content.about.content}</p>
        <p class="cr-desc">{content.description}</p>
      </article>

      <article class="cr-cell cr-tall">
        <img src={config.aboutImage ?? config.gallery[0]} alt="" />
      </article>

      <article class="cr-cell cr-hours">
        <h2>{t('hours.title')}</h2>
        <ul>
          {content.openingHours.map((hour) => {
            const row = formatOpeningHours(t, hour);
            return (
              <li>
                <span>{row.label}</span>
                <span>{row.value}</span>
              </li>
            );
          })}
        </ul>
      </article>

      <article class="cr-cell cr-cta">
        <h2>{content.ctaLabel ?? t('cta.callNow')}</h2>
        <a class="cr-btn" href={telHref}>{config.phone}</a>
        <a class="cr-btn cr-btn-ghost" href={orderHref}>{content.secondaryCtaLabel ?? t('cta.orderNow')}</a>
      </article>

      <article class="cr-cell cr-wide" id="menu">
        <h2>{content.menuSectionLabel ?? t('menu.title')}</h2>
        <div class="cr-menu">
          {menuItems.slice(0, 6).map((item) => (
            <div>
              <strong>{item.name}</strong>
              <span>{item.price}</span>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </article>

      <article class="cr-cell cr-cinema">
        <img src={config.gallery[0]} alt="" loading="lazy" />
      </article>

      <article class="cr-cell cr-ig" aria-label={t('instagram.title')}>
        <h2>{t('instagram.title')}</h2>
        <div class="cr-ig-grid">
          {ig.slice(0, 6).map((src) => (
            <img src={src} alt="" loading="lazy" />
          ))}
        </div>
      </article>

      <article class="cr-cell cr-visit" id="contact">
        <h2>{t('contact.visitUs')}</h2>
        <p>
          {config.address.street}<br />
          {config.address.postalCode} {config.address.city}
        </p>
        {config.deliveryLinks && config.deliveryLinks.length > 0 && (
          <div class="cr-delivery">
            {config.deliveryLinks.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>
            ))}
          </div>
        )}
        <iframe
          title={`${config.name} map`}
          src={config.googleMapsEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </article>
    </div>

    <Footer config={config} lang={lang} />
  </div>
</BaseLayout>

<style>
  .cr {
    background:
      radial-gradient(900px 420px at 90% -10%, color-mix(in srgb, var(--color-accent) 35%, transparent), transparent 55%),
      radial-gradient(700px 380px at 0% 20%, color-mix(in srgb, var(--color-secondary) 12%, transparent), transparent 50%),
      var(--color-background);
  }

  .cr-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.15rem;
  }

  .cr-top > a {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }

  .cr-bento {
    display: grid;
    gap: 0.85rem;
    padding: 0 1.15rem 3rem;
    max-width: 78rem;
    margin: 0 auto;
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .cr-bento {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: minmax(7.5rem, auto);
    }

    .cr-hero { grid-column: 1 / span 8; grid-row: span 3; }
    .cr-special { grid-column: 9 / span 4; grid-row: span 2; }
    .cr-story { grid-column: 9 / span 4; grid-row: span 2; }
    .cr-tall { grid-column: 1 / span 4; grid-row: span 4; }
    .cr-hours { grid-column: 5 / span 4; grid-row: span 2; }
    .cr-cta { grid-column: 9 / span 4; grid-row: span 2; }
    .cr-wide { grid-column: 5 / span 8; grid-row: span 3; }
    .cr-cinema { grid-column: 1 / span 7; grid-row: span 2; }
    .cr-ig { grid-column: 8 / span 5; grid-row: span 2; }
    .cr-visit { grid-column: 1 / span 12; grid-row: span 2; }
  }

  .cr-cell {
    background: color-mix(in srgb, var(--color-surface) 92%, white);
    border-radius: 1.5rem;
    padding: 1.15rem;
    overflow: hidden;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-secondary) 8%, transparent);
  }

  .cr-hero {
    position: relative;
    padding: 0;
    min-height: 280px;
  }

  .cr-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cr-hero > div {
    position: relative;
    z-index: 1;
    height: 100%;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.35rem;
    background: linear-gradient(180deg, transparent 30%, rgba(20, 18, 30, 0.72));
    color: #fff9f0;
  }

  .cr-hero h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1;
  }

  .cr-hero p {
    margin: 0.55rem 0 0;
    opacity: 0.9;
  }

  .cr-special {
    background: var(--color-primary);
    color: var(--color-on-primary-text);
  }

  .cr-special p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7rem;
    font-weight: 700;
    opacity: 0.8;
  }

  .cr-special h2 {
    margin: 0.7rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    line-height: 1.25;
  }

  .cr-story h2,
  .cr-hours h2,
  .cr-cta h2,
  .cr-wide h2,
  .cr-ig h2,
  .cr-visit h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.35rem;
  }

  .cr-story p {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .cr-desc {
    color: var(--color-text) !important;
    font-weight: 600;
  }

  .cr-tall {
    padding: 0;
    min-height: 280px;
  }

  .cr-tall img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    display: block;
  }

  .cr-hours ul {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
  }

  .cr-hours li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-muted) 18%, transparent);
    font-size: 0.88rem;
  }

  .cr-cta {
    background: var(--color-secondary);
    color: #fff9f0;
  }

  .cr-cta h2 {
    color: #fff9f0;
  }

  .cr-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    margin-top: 0.85rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .cr-btn-ghost {
    background: transparent;
    border: 1px solid color-mix(in srgb, #fff9f0 45%, transparent);
    color: #fff9f0;
  }

  .cr-menu {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  @media (min-width: 640px) {
    .cr-menu {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cr-menu strong {
    display: block;
    font-size: 1rem;
  }

  .cr-menu span {
    float: right;
    margin-top: -1.15rem;
    color: var(--color-primary);
    font-weight: 700;
  }

  .cr-menu p {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.88rem;
    clear: both;
  }

  .cr-cinema {
    padding: 0;
    min-height: 200px;
  }

  .cr-cinema img {
    width: 100%;
    height: 100%;
    min-height: 200px;
    object-fit: cover;
    display: block;
  }

  .cr-ig-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
    margin-top: 0.85rem;
  }

  .cr-ig-grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  .cr-visit p {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .cr-delivery {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .cr-delivery a {
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-secondary) 10%, white);
    color: var(--color-secondary);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .cr-visit iframe {
    width: 100%;
    min-height: 200px;
    border: 0;
    border-radius: 1rem;
    margin-top: 1rem;
  }
</style>
