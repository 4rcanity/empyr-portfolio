---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../components/shared/LanguageSwitcher.astro';
import Footer from '../../components/shared/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const reserveHref = config.reservationUrl ?? `mailto:${config.email}`;
const gallery = config.gallery;
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="nr" data-archetype="cinematic-editorial">
    <header class="nr-top">
      <a href={`/${lang}/${config.slug}`}>{config.name}</a>
      <LanguageSwitcher lang={lang} slug={config.slug} variant="dark" />
    </header>

    <section class="nr-hero">
      <img src={config.heroImage} alt="" class="nr-hero-img" />
      <div class="nr-hero-veil" />
      <div class="nr-hero-copy">
        <p>{config.address.city}</p>
        <h1>{config.name}</h1>
        <p class="nr-tag">{content.tagline}</p>
      </div>
      <p class="nr-float nr-float-a">{content.description}</p>
    </section>

    <section class="nr-menu" id="menu">
      <div class="nr-menu-intro">
        <h2>{content.menuSectionLabel ?? t('menu.title')}</h2>
        <p>{content.bookingNote}</p>
      </div>
      <div class="nr-menu-list">
        {content.menu.map((cat) => (
          <div class="nr-course">
            <h3>{cat.name}</h3>
            {cat.items.map((item) => (
              <article>
                <div>
                  <h4>{item.name}</h4>
                  <p>{item.description}</p>
                </div>
                <span>{item.price}</span>
              </article>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section class="nr-lateral" id="gallery" aria-label={t('gallery.title')}>
      {gallery.map((src, i) => (
        <figure class={`nr-panel nr-panel-${i % 3}`}>
          <img src={src} alt="" loading="lazy" />
          {i === 0 && <figcaption class="nr-float nr-float-b">{content.about.heading}</figcaption>}
          {i === 1 && <figcaption class="nr-float nr-float-c">{content.about.content}</figcaption>}
        </figure>
      ))}
    </section>

    <section class="nr-visit" id="contact">
      <div>
        <h2>{t('contact.visitUs')}</h2>
        <p>
          {config.address.street}<br />
          {config.address.postalCode} {config.address.city}
        </p>
        <p><a href={`tel:${config.phone.replace(/\s/g, '')}`}>{config.phone}</a></p>
        <ul>
          {content.openingHours.map((hour) => {
            const row = formatOpeningHours(t, hour);
            return (
              <li>
                <span>{row.label}</span>
                <span>{row.value}</span>
              </li>
            );
          })}
        </ul>
      </div>
      <iframe
        title={`${config.name} map`}
        src={config.googleMapsEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </section>

    <div class="nr-reserve">
      <span>{content.ctaLabel ?? t('nav.reserve')}</span>
      <a href={reserveHref}>{content.ctaLabel ?? t('cta.bookNow')}</a>
    </div>

    <Footer config={config} lang={lang} />
  </div>
</BaseLayout>

<style>
  .nr {
    padding-bottom: 5rem;
  }

  .nr-top {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.15rem 1.35rem;
  }

  .nr-top a {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }

  .nr-hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: end start;
    overflow: hidden;
  }

  .nr-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nr-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 7, 6, 0.35), rgba(8, 7, 6, 0.78) 70%, var(--color-background));
  }

  .nr-hero-copy {
    position: relative;
    z-index: 1;
    padding: 0 1.35rem 18vh;
    max-width: 28rem;
  }

  .nr-hero-copy > p:first-child {
    margin: 0;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--color-accent);
  }

  .nr-hero h1 {
    margin: 0.6rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(3rem, 10vw, 6.5rem);
    line-height: 0.9;
    font-weight: 500;
  }

  .nr-tag {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .nr-float {
    margin: 0;
    position: absolute;
    z-index: 2;
    max-width: min(28rem, 72vw);
    padding: 1rem 1.15rem;
    background: color-mix(in srgb, #0c0b0a 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-text);
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .nr-float-a {
    right: 1.25rem;
    bottom: 8vh;
  }

  @media (max-width: 760px) {
    .nr-float-a {
      position: relative;
      right: auto;
      bottom: auto;
      margin: 0 1.35rem 2rem;
      z-index: 1;
    }
  }

  .nr-menu {
    display: grid;
    gap: 2.5rem;
    padding: 5rem 1.35rem 4rem;
    max-width: 58rem;
    margin: 0 auto;
  }

  @media (min-width: 880px) {
    .nr-menu {
      grid-template-columns: 0.7fr 1.3fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .nr-menu-intro h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 500;
    line-height: 1;
  }

  .nr-menu-intro p {
    margin: 1rem 0 0;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .nr-course + .nr-course {
    margin-top: 2.5rem;
  }

  .nr-course h3 {
    margin: 0 0 1rem;
    color: var(--color-accent);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .nr-course article {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.15rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .nr-course h4 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 500;
  }

  .nr-course p {
    margin: 0.4rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .nr-course span {
    color: var(--color-accent);
    white-space: nowrap;
    font-size: 1rem;
  }

  .nr-lateral {
    display: grid;
    gap: 0.65rem;
    padding: 0 0 4rem;
  }

  @media (min-width: 800px) {
    .nr-lateral {
      grid-auto-flow: column;
      grid-auto-columns: minmax(68vw, 1fr);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 5rem;
    }
  }

  .nr-panel {
    margin: 0;
    position: relative;
    scroll-snap-align: start;
  }

  .nr-panel img {
    width: 100%;
    height: min(72vh, 640px);
    object-fit: cover;
    display: block;
  }

  .nr-float-b {
    left: 1.25rem;
    bottom: 1.25rem;
    font-family: var(--font-heading);
    font-size: 1.6rem;
  }

  .nr-float-c {
    left: 1.25rem;
    bottom: 1.25rem;
    max-width: min(34rem, 80%);
  }

  .nr-visit {
    display: grid;
    gap: 1.5rem;
    padding: 0 1.35rem 4rem;
    max-width: 70rem;
    margin: 0 auto;
  }

  @media (min-width: 800px) {
    .nr-visit {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  .nr-visit h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 500;
  }

  .nr-visit p {
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .nr-visit a {
    color: var(--color-text);
    text-decoration: none;
  }

  .nr-visit ul {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .nr-visit li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    font-size: 0.92rem;
  }

  .nr-visit iframe {
    width: 100%;
    min-height: 280px;
    border: 0;
  }

  .nr-reserve {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0.55rem 0.55rem 1.1rem;
    border-radius: 999px;
    background: color-mix(in srgb, #0c0b0a 88%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
    backdrop-filter: blur(10px);
    max-width: calc(100vw - 1.5rem);
  }

  .nr-reserve span {
    color: var(--color-muted);
    font-size: 0.85rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nr-reserve a {
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
  }
</style>
