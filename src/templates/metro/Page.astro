---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../components/shared/LanguageSwitcher.astro';
import Footer from '../../components/shared/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const services = content.menu.flatMap((cat) =>
  cat.items.map((item) => ({ ...item, category: cat.name }))
);
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="metro" data-archetype="modular-bento">
    <!-- 1. Compact hero strip (not tall overlay hero) -->
    <header class="metro-strip">
      <div class="metro-strip-copy">
        <div class="metro-strip-top">
          <a href={`/${lang}/${config.slug}`} class="metro-brand">{config.name}</a>
          <LanguageSwitcher lang={lang} slug={config.slug} variant="dark" />
        </div>
        <h1>{content.tagline}</h1>
        <p>{content.description}</p>
      </div>
      <div class="metro-strip-media" style={`background-image: url(${config.heroImage})`} role="img" aria-label={config.name} />
    </header>

    <!-- 2. Dense bento: services / hours / rating / CTA -->
    <section class="metro-bento" id="menu" aria-label={content.menuSectionLabel ?? t('menu.title')}>
      {services.slice(0, 4).map((item, i) => (
        <article class={`metro-tile metro-service metro-s${i + 1}`}>
          <p class="metro-cat">{item.category}</p>
          <h2>{item.name}</h2>
          <p>{item.description}</p>
          <strong>{item.price}</strong>
        </article>
      ))}

      <article class="metro-tile metro-hours">
        <h2>{t('hours.title')}</h2>
        <ul>
          {content.openingHours.map((hour) => {
            const row = formatOpeningHours(t, hour);
            return (
              <li>
                <span>{row.label}</span>
                <span>{row.value}</span>
              </li>
            );
          })}
        </ul>
      </article>

      {config.rating && (
        <article class="metro-tile metro-rating">
          <p class="metro-score">{config.rating.value}</p>
          <p>{config.rating.count} {config.rating.source}</p>
          {content.ratingNote && <p class="metro-note">{content.ratingNote}</p>}
        </article>
      )}

      <article class="metro-tile metro-cta" id="contact">
        <h2>{content.ctaLabel ?? t('cta.callNow')}</h2>
        {content.bookingNote && <p>{content.bookingNote}</p>}
        {config.reservationUrl && (
          <a href={config.reservationUrl}>{content.ctaLabel ?? t('cta.callNow')}</a>
        )}
        <a class="metro-mail" href={`mailto:${config.email}`}>{config.email}</a>
      </article>

      {services.slice(4).map((item) => (
        <article class="metro-tile metro-service">
          <p class="metro-cat">{item.category}</p>
          <h2>{item.name}</h2>
          <p>{item.description}</p>
          <strong>{item.price}</strong>
        </article>
      ))}
    </section>

    <!-- 3. Compact photo strip -->
    <section class="metro-photos" id="gallery" aria-label={t('gallery.title')}>
      {[config.aboutImage, ...config.gallery].filter(Boolean).map((src) => (
        <img src={src as string} alt="" loading="lazy" />
      ))}
    </section>

    <!-- 4. Short about + map -->
    <section class="metro-about" id="about">
      <div>
        <h2>{content.about.heading}</h2>
        <p>{content.about.content}</p>
        <p class="metro-addr">
          {config.address.street}, {config.address.postalCode} {config.address.city} · {config.phone}
        </p>
      </div>
      <iframe
        title={`${config.name} map`}
        src={config.googleMapsEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </section>

    {content.testimonials && content.testimonials.length > 0 && (
      <section class="metro-quotes" aria-label={t('testimonials.title')}>
        {content.testimonials.map((item) => (
          <blockquote>
            <p>“{item.quote}”</p>
            <footer>{item.author}</footer>
          </blockquote>
        ))}
      </section>
    )}

    <Footer config={config} lang={lang} />
  </div>
</BaseLayout>

<style>
  .metro-strip {
    display: grid;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  @media (min-width: 860px) {
    .metro-strip {
      grid-template-columns: 1.2fr 0.8fr;
      min-height: 220px;
    }
  }

  .metro-strip-copy {
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .metro-strip-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .metro-brand {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 700;
  }

  .metro-strip h1 {
    margin: 1rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    line-height: 1.05;
    text-transform: uppercase;
    max-width: 22ch;
  }

  .metro-strip p {
    margin: 0.65rem 0 0;
    color: var(--color-muted);
    max-width: 48ch;
    font-size: 0.95rem;
  }

  .metro-strip-media {
    min-height: 140px;
    background-size: cover;
    background-position: center;
  }

  .metro-bento {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .metro-bento {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: minmax(140px, auto);
    }

    .metro-s1 { grid-column: span 3; }
    .metro-s2 { grid-column: span 3; }
    .metro-s3 { grid-column: span 2; }
    .metro-s4 { grid-column: span 2; }
    .metro-hours { grid-column: span 2; grid-row: span 2; }
    .metro-rating { grid-column: span 2; }
    .metro-cta { grid-column: span 4; }
    .metro-service:not(.metro-s1):not(.metro-s2):not(.metro-s3):not(.metro-s4) {
      grid-column: span 3;
    }
  }

  .metro-tile {
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
    background: var(--color-surface);
  }

  .metro-cat {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .metro-tile h2 {
    margin: 0.45rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    text-transform: uppercase;
  }

  .metro-tile p {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .metro-tile strong {
    display: inline-block;
    margin-top: 0.85rem;
    color: var(--color-accent);
  }

  .metro-hours ul {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
  }

  .metro-hours li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-muted) 20%, transparent);
    font-size: 0.85rem;
  }

  .metro-score {
    margin: 0 !important;
    font-family: var(--font-heading);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .metro-note {
    color: var(--color-text) !important;
  }

  .metro-cta {
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
  }

  .metro-cta a {
    display: inline-flex;
    margin-top: 1rem;
    padding: 0.75rem 1.1rem;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.78rem;
  }

  .metro-mail {
    display: block !important;
    margin-top: 0.75rem !important;
    background: transparent !important;
    color: var(--color-text) !important;
    padding: 0 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    font-weight: 500 !important;
  }

  .metro-photos {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(160px, 28vw);
    overflow-x: auto;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem 1rem;
  }

  .metro-photos img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .metro-about {
    display: grid;
    gap: 1rem;
    padding: 2rem 1.25rem 3rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  @media (min-width: 860px) {
    .metro-about {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  .metro-about h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.8rem;
    text-transform: uppercase;
  }

  .metro-about p {
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .metro-addr {
    color: var(--color-text) !important;
  }

  .metro-about iframe {
    width: 100%;
    min-height: 240px;
    border: 0;
  }

  .metro-quotes {
    display: grid;
    gap: 0.75rem;
    padding: 0 0.75rem 3rem;
  }

  @media (min-width: 800px) {
    .metro-quotes { grid-template-columns: 1fr 1fr; }
  }

  .metro-quotes blockquote {
    margin: 0;
    padding: 1rem;
    border: 1px dashed color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .metro-quotes p {
    margin: 0;
    font-size: 0.98rem;
  }

  .metro-quotes footer {
    margin-top: 0.65rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
</style>
