---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const telHref = `tel:${config.phone.replace(/\s/g, '')}`;
const year = new Date().getFullYear();
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="es">
    <header class="es-header">
      <a class="es-brand" href={`/${lang}/${config.slug}`}>
        {config.logo && <img class="es-brand-logo" src={config.logo} alt="" width="128" height="40" />}
        <span>{config.name}</span>
      </a>
      <a class="es-header-cta" href={telHref}>{content.ctaLabel ?? t('cta.callNow')}</a>
    </header>

    <main class="es-main">
      <section class="es-intro" aria-labelledby="es-intro-title">
        <div class="es-intro-copy">
          <p class="es-kicker">{content.tagline}</p>
          <h1 id="es-intro-title" class="es-title">{config.name}</h1>
          <p class="es-lead">{content.description}</p>
          <a class="es-btn" href={telHref}>
            <span class="es-btn-label">{content.ctaLabel ?? t('cta.callNow')}</span>
            <span class="es-btn-phone">{config.phone}</span>
          </a>
          <p class="es-about">{content.about.content}</p>
        </div>
        <figure class="es-intro-photo">
          <img
            src={config.heroImage}
            alt=""
            width="720"
            height="540"
            loading="eager"
          />
        </figure>
      </section>

      <section class="es-services" id="zorg" aria-labelledby="es-services-title">
        <h2 id="es-services-title" class="es-section-title">
          {content.menuSectionLabel ?? t('menu.title')}
        </h2>
        <ul class="es-service-list">
          {content.menu.flatMap((cat) =>
            cat.items.map((item) => (
              <li class="es-service-card">
                <div class="es-service-head">
                  <h3>{item.name}</h3>
                  <span class="es-service-note">{item.price}</span>
                </div>
                <p>{item.description}</p>
              </li>
            ))
          )}
        </ul>
      </section>

      <section class="es-contact" id="contact" aria-labelledby="es-contact-title">
        <div class="es-contact-panel">
          <h2 id="es-contact-title" class="es-section-title">{t('contact.visitUs')}</h2>

          <div class="es-contact-grid">
            <div class="es-contact-block">
              <h3>Telefoon</h3>
              <p><a href={telHref}>{config.phone}</a></p>
            </div>
            <div class="es-contact-block">
              <h3>E-mail</h3>
              <p><a href={`mailto:${config.email}`}>{config.email}</a></p>
            </div>
            <div class="es-contact-block">
              <h3>Adres</h3>
              <address>
                {config.address.street}<br />
                {config.address.postalCode} {config.address.city}
              </address>
            </div>
            <div class="es-contact-block">
              <h3>{t('hours.title')}</h3>
              <ul class="es-hours">
                {content.openingHours.map((hour) => {
                  const row = formatOpeningHours(t, hour);
                  return (
                    <li>
                      <span>{row.label}</span>
                      <span>{row.value}</span>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>

          {content.bookingNote && <p class="es-note">{content.bookingNote}</p>}

          <iframe
            class="es-map"
            title={`Kaart met locatie van ${config.name}`}
            aria-label={`Kaart met locatie van ${config.name}, ${config.address.street}, ${config.address.city}`}
            src={config.googleMapsEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      </section>
    </main>

    <footer class="es-footer">
      <p>&copy; {year} {config.name}. {t('footer.rights')}</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .es {
    min-height: 100vh;
    background: var(--color-background);
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .es-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem 1.25rem;
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-muted) 16%, transparent);
  }

  /* Keep the full name readable instead of truncating it next to the button */
  @media (max-width: 30rem) {
    .es-header {
      gap: 0.5rem;
    }

    .es-brand {
      width: 100%;
      min-height: 0;
    }

    .es-header-cta {
      min-height: 2.5rem;
    }
  }

  .es-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    min-height: 2.75rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .es-brand span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .es-brand-logo {
    flex: none;
    height: 1.9rem;
    width: auto;
    border-radius: 4px;
  }

  .es-header-cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .es-main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
  }

  @media (min-width: 768px) {
    .es-main {
      max-width: 52rem;
      padding: 2.5rem 1.5rem 4rem;
    }
  }

  .es-intro {
    display: grid;
    gap: 2rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .es-intro {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2.5rem;
    }
  }

  .es-kicker {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.01em;
  }

  .es-title {
    margin: 0.5rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .es-lead {
    margin: 1rem 0 0;
    max-width: 34rem;
    color: var(--color-muted);
  }

  .es-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    margin-top: 1.5rem;
    padding: 0.9rem 1.35rem;
    border-radius: 0.875rem;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    text-decoration: none;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  .es-btn-label {
    font-weight: 700;
    font-size: 1rem;
  }

  .es-btn-phone {
    font-size: 0.9375rem;
    opacity: 0.92;
  }

  .es-about {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-muted) 18%, transparent);
    color: var(--color-text);
    font-size: 1rem;
  }

  .es-intro-photo {
    margin: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 10px 32px color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .es-intro-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .es-section-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .es-services {
    margin-bottom: 3rem;
    padding-top: 0.5rem;
  }

  .es-service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.875rem;
  }

  .es-service-card {
    padding: 1.25rem 1.35rem;
    border-radius: 1rem;
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-muted) 14%, transparent);
    box-shadow: 0 2px 10px color-mix(in srgb, var(--color-primary) 5%, transparent);
  }

  .es-service-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .es-service-card h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .es-service-note {
    font-size: 0.875rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .es-service-card p {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .es-contact-panel {
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-muted) 14%, transparent);
    box-shadow: 0 6px 24px color-mix(in srgb, var(--color-primary) 7%, transparent);
  }

  @media (min-width: 640px) {
    .es-contact-panel {
      padding: 2rem;
    }
  }

  .es-contact-grid {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .es-contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 2rem;
    }
  }

  .es-contact-block h3 {
    margin: 0 0 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .es-contact-block p {
    margin: 0;
  }

  .es-contact-block a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .es-note {
    margin: 1.5rem 0 0;
    max-width: 34rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .es-contact-block a:hover {
    text-decoration: underline;
  }

  .es-contact-block address {
    font-style: normal;
    line-height: 1.6;
  }

  .es-hours {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .es-hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0;
    font-size: 1rem;
    color: var(--color-muted);
  }

  .es-map {
    width: 100%;
    min-height: 220px;
    border: 0;
    border-radius: 0.875rem;
  }

  .es-footer {
    padding: 1.75rem 1.25rem 2.5rem;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--color-muted);
    border-top: 1px solid color-mix(in srgb, var(--color-muted) 14%, transparent);
  }

  .es-footer p {
    margin: 0;
  }

  .es-brand:focus-visible,
  .es-header-cta:focus-visible,
  .es-btn:focus-visible,
  .es-contact-block a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
