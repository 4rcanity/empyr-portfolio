---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const telHref = `tel:${config.phone.replace(/\s/g, '')}`;
const year = new Date().getFullYear();
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="hm">
    <header class="hm-header">
      <a class="hm-brand" href={`/${lang}/${config.slug}`}>
        {config.logo && <img class="hm-brand-logo" src={config.logo} alt="" width="128" height="40" />}
        <span>{config.name}</span>
      </a>
      <a class="hm-header-phone" href={telHref}>{config.phone}</a>
    </header>

    <section class="hm-hero">
      <div class="hm-hero-arch">
        <img src={config.heroImage} alt="" class="hm-hero-img" width="1600" height="900" />
      </div>
      <div class="hm-hero-copy">
        <p class="hm-kicker">{content.tagline}</p>
        <h1>{config.name}</h1>
        <p class="hm-lead">{content.description}</p>
        <a class="hm-cta" href={telHref}>{content.ctaLabel}</a>
      </div>
    </section>

    <section class="hm-about">
      <p>{content.about.content}</p>
    </section>

    <section class="hm-treatments" id="behandelingen">
      <header class="hm-section-head">
        <span class="hm-ornament" aria-hidden="true" />
        <h2>{content.menuSectionLabel}</h2>
      </header>

      <div class="hm-treatments-grid">
        {content.menu.map((cat) => (
          <div class="hm-col">
            <h3 class="hm-col-title">{cat.name}</h3>
            <ul class="hm-price-list">
              {cat.items.map((item) => (
                <li>
                  <div class="hm-item-main">
                    <span class="hm-item-name">{item.name}</span>
                    {item.description && <span class="hm-item-desc">{item.description}</span>}
                  </div>
                  <span class="hm-item-dots" aria-hidden="true" />
                  <span class="hm-item-price">{item.price}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="hm-gallery" aria-label={t('gallery.title')}>
      <header class="hm-section-head hm-section-head--compact">
        <span class="hm-ornament" aria-hidden="true" />
        <h2>{t('gallery.title')}</h2>
      </header>
      <div class="hm-gallery-row">
        {config.gallery.map((src) => (
          <figure class="hm-gallery-item">
            <div class="hm-gallery-arch">
              <img src={src} alt="" loading="lazy" width="400" height="480" />
            </div>
          </figure>
        ))}
      </div>
    </section>

    <section class="hm-contact" id="contact">
      <div class="hm-contact-panel">
        <header class="hm-contact-head">
          <h2>{t('contact.visitUs')}</h2>
        </header>

        <div class="hm-contact-body">
          <div class="hm-contact-info">
            <address class="hm-address">
              <strong>{config.name}</strong>
              {config.address.street}<br />
              {config.address.postalCode} {config.address.city}
            </address>

            <div class="hm-contact-links">
              <a href={telHref}>{config.phone}</a>
              <a href={`mailto:${config.email}`}>{config.email}</a>
            </div>

            <div class="hm-hours">
              <h3>{t('hours.title')}</h3>
              <table class="hm-hours-table">
                <tbody>
                  {content.openingHours.map((hour) => {
                    const row = formatOpeningHours(t, hour);
                    return (
                      <tr>
                        <th scope="row">{row.label}</th>
                        <td>{row.value}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {content.bookingNote && <p class="hm-note">{content.bookingNote}</p>}
          </div>

          <div class="hm-map-wrap">
            <iframe
              title={`${config.name} kaart`}
              src={config.googleMapsEmbed}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        </div>
      </div>
    </section>

    <footer class="hm-foot">
      <p>&copy; {year} {config.name}. {t('footer.rights')}</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .hm {
    --hm-shadow: 0 18px 48px color-mix(in srgb, var(--color-primary) 12%, transparent);
    --hm-tile: color-mix(in srgb, var(--color-accent) 8%, transparent);
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-body);
    padding-bottom: 3rem;
    background-image:
      linear-gradient(135deg, var(--hm-tile) 25%, transparent 25%),
      linear-gradient(225deg, var(--hm-tile) 25%, transparent 25%),
      linear-gradient(45deg, var(--hm-tile) 25%, transparent 25%),
      linear-gradient(315deg, var(--hm-tile) 25%, var(--color-background) 25%);
    background-size: 28px 28px;
    background-position:
      0 0,
      0 14px,
      14px -14px,
      -14px 0;
  }

  .hm-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .hm-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    min-height: 2.75rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-primary);
    text-decoration: none;
  }

  .hm-brand span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hm-brand-logo {
    flex: none;
    height: 1.9rem;
    width: auto;
    border-radius: 2px;
  }

  .hm-header-phone {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .hm-header-phone:hover {
    text-decoration: underline;
  }

  /* ── Hero ── */
  .hm-hero {
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 0;
    text-align: center;
  }

  .hm-hero-arch {
    position: relative;
    max-width: 28rem;
    margin: 0 auto;
    border-radius: 50% 50% 0 0 / 42% 42% 0 0;
    overflow: hidden;
    box-shadow: var(--hm-shadow);
    border: 3px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
  }

  .hm-hero-arch::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 55%,
      color-mix(in srgb, var(--color-primary) 18%, transparent) 100%
    );
    pointer-events: none;
  }

  .hm-hero-img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .hm-hero-copy {
    padding: 2rem 0.5rem 0;
  }

  .hm-kicker {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hm-hero h1 {
    margin: 0.75rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 6.5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-primary);
  }

  .hm-lead {
    margin: 1rem auto 0;
    max-width: 28rem;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .hm-cta {
    display: inline-flex;
    align-items: center;
    margin-top: 1.5rem;
    padding: 0.8rem 1.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-accent) 32%, transparent);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .hm-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  /* ── About ── */
  .hm-about {
    max-width: 36rem;
    margin: 0 auto;
    padding: 2.75rem 1.25rem 0;
    text-align: center;
  }

  .hm-about p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2.8vw, 1.4rem);
    font-style: italic;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* ── Section heads ── */
  .hm-section-head {
    text-align: center;
    margin-bottom: 2.25rem;
  }

  .hm-section-head--compact {
    margin-bottom: 1.75rem;
  }

  .hm-ornament {
    display: block;
    width: 3rem;
    height: 0.75rem;
    margin: 0 auto 1rem;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    background: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .hm-section-head h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 4.5vw, 2.5rem);
    font-weight: 400;
    color: var(--color-primary);
  }

  /* ── Treatments ── */
  .hm-treatments {
    max-width: 52rem;
    margin: 0 auto;
    padding: 4rem 1.25rem;
  }

  .hm-treatments-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 720px) {
    .hm-treatments-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }

  .hm-col-title {
    margin: 0 0 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 2px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 500;
    text-align: center;
    color: var(--color-primary);
  }

  .hm-price-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hm-price-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: 0.35rem 0.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .hm-item-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    text-align: left;
  }

  .hm-item-name {
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .hm-item-desc {
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .hm-item-dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--color-accent) 35%, transparent);
    align-self: baseline;
    margin-bottom: 0.25rem;
  }

  .hm-item-price {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
  }

  /* ── Gallery ── */
  .hm-gallery {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
  }

  .hm-gallery-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .hm-gallery-row {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
  }

  .hm-gallery-item {
    margin: 0;
  }

  .hm-gallery-arch {
    border-radius: 50% 50% 0 0 / 38% 38% 0 0;
    overflow: hidden;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 2px solid color-mix(in srgb, var(--color-surface) 80%, var(--color-accent));
  }

  .hm-gallery-arch img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* ── Contact panel ── */
  .hm-contact {
    padding: 0 1.25rem 3rem;
  }

  .hm-contact-panel {
    max-width: 52rem;
    margin: 0 auto;
    padding: 2.5rem 1.75rem;
    border-radius: 1.5rem;
    background: var(--color-surface);
    box-shadow: var(--hm-shadow);
    border: 1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .hm-contact-head {
    text-align: center;
    margin-bottom: 2rem;
  }

  .hm-contact-head h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 400;
    color: var(--color-primary);
  }

  .hm-contact-body {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .hm-contact-body {
      grid-template-columns: 1fr 1.15fr;
      gap: 2.5rem;
      align-items: start;
    }
  }

  .hm-address {
    font-style: normal;
    line-height: 1.7;
    color: var(--color-muted);
    text-align: center;
  }

  @media (min-width: 768px) {
    .hm-address {
      text-align: left;
    }
  }

  .hm-address strong {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .hm-contact-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 0.85rem;
  }

  @media (min-width: 768px) {
    .hm-contact-links {
      align-items: flex-start;
    }
  }

  .hm-contact-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  .hm-note {
    margin: 1.5rem 0 0;
    max-width: 32rem;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .hm-contact-links a:hover {
    text-decoration: underline;
  }

  .hm-hours {
    margin-top: 1.75rem;
  }

  .hm-hours h3 {
    margin: 0 0 0.75rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-align: center;
  }

  @media (min-width: 768px) {
    .hm-hours h3 {
      text-align: left;
    }
  }

  .hm-hours-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .hm-hours-table th,
  .hm-hours-table td {
    padding: 0.45rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    text-align: left;
    font-weight: 400;
  }

  .hm-hours-table th {
    color: var(--color-muted);
    padding-right: 1.25rem;
    white-space: nowrap;
  }

  .hm-map-wrap iframe {
    width: 100%;
    min-height: 260px;
    border: none;
    border-radius: 1rem;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  /* ── Footer ── */
  .hm-foot {
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 0;
    text-align: center;
  }

  .hm-foot p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-muted);
  }
</style>
