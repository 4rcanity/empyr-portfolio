---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../components/shared/LanguageSwitcher.astro';
import Footer from '../../components/shared/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const telHref = `tel:${config.phone.replace(/\s/g, '')}`;
const whatsappHref =
  config.reservationUrl?.startsWith('https://wa.me/')
    ? config.reservationUrl
    : `https://wa.me/${config.phone.replace(/\D/g, '')}`;
const photos = [config.aboutImage, ...config.gallery].filter(Boolean) as string[];
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="oak" data-archetype="warm-asym-columns">
    <header class="oak-bar">
      <a class="oak-brand" href={`/${lang}/${config.slug}`}>{config.name}</a>
      <nav>
        <a href="#care">{content.menuSectionLabel ?? t('menu.title')}</a>
        <a href="#plan">{t('nav.contact')}</a>
      </nav>
      <LanguageSwitcher lang={lang} slug={config.slug} variant="light" />
    </header>

    <section class="oak-hero">
      <div class="oak-hero-copy">
        <p class="oak-eyebrow">{config.address.city}</p>
        <h1>{content.tagline}</h1>
        <p>{content.description}</p>
        <div class="oak-actions">
          <a href={telHref}>{t('cta.callNow')}</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      </div>
      <figure class="oak-hero-photo">
        <img src={config.heroImage} alt="" />
      </figure>
    </section>

    <section class="oak-bleed" aria-hidden="true">
      <img src={photos[0] ?? config.heroImage} alt="" />
    </section>

    <section class="oak-split" id="care">
      <div class="oak-col oak-col-wide">
        <h2>{content.about.heading}</h2>
        <p class="oak-lead">{content.about.content}</p>
        {content.menu.map((cat) => (
          <div class="oak-group">
            <h3>{cat.name}</h3>
            {cat.items.map((item) => (
              <div class="oak-line">
                <div>
                  <strong>{item.name}</strong>
                  <p>{item.description}</p>
                </div>
                <span>{item.price}</span>
              </div>
            ))}
          </div>
        ))}
      </div>

      <aside class="oak-col oak-pane" id="plan">
        <h2>{t('hours.title')}</h2>
        <ul>
          {content.openingHours.map((hour) => {
            const row = formatOpeningHours(t, hour);
            return (
              <li>
                <span>{row.label}</span>
                <span>{row.value}</span>
              </li>
            );
          })}
        </ul>
        {content.bookingNote && <p class="oak-note">{content.bookingNote}</p>}
        <p class="oak-addr">
          {config.address.street}<br />
          {config.address.postalCode} {config.address.city}<br />
          <a href={telHref}>{config.phone}</a>
        </p>
        <div class="oak-actions">
          <a href={telHref}>{t('cta.callNow')}</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
        <iframe
          title={`${config.name} map`}
          src={config.googleMapsEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </aside>
    </section>

    <section class="oak-bleed oak-bleed-alt" aria-label={t('gallery.title')}>
      <img src={photos[1] ?? config.heroImage} alt="" loading="lazy" />
      <img src={photos[2] ?? config.heroImage} alt="" loading="lazy" />
    </section>

    <Footer config={config} lang={lang} />
  </div>
</BaseLayout>

<style>
  .oak {
    background:
      radial-gradient(1200px 500px at 10% -10%, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 60%),
      var(--color-background);
  }

  .oak-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.35rem;
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--color-background) 88%, white 12%);
    backdrop-filter: blur(12px);
  }

  .oak-brand {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .oak-bar nav {
    display: none;
    gap: 1.25rem;
    margin-right: auto;
    margin-left: 1.5rem;
  }

  @media (min-width: 720px) {
    .oak-bar nav { display: flex; }
  }

  .oak-bar nav a {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .oak-hero {
    display: grid;
    gap: 2rem;
    padding: 2rem 1.35rem 3rem;
    max-width: 78rem;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .oak-hero {
      grid-template-columns: 0.92fr 1.08fr;
      align-items: center;
      min-height: 72vh;
      gap: 4rem;
    }
  }

  .oak-eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--color-accent) 80%, white);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .oak-hero h1 {
    margin: 0.7rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1.05;
    max-width: 12ch;
  }

  .oak-hero-copy > p:last-of-type {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.65;
    max-width: 36ch;
  }

  .oak-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .oak-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .oak-actions a:last-child {
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-text) 28%, transparent);
    color: var(--color-text);
  }

  .oak-hero-photo {
    margin: 0;
    justify-self: end;
    width: min(100%, 34rem);
  }

  .oak-hero-photo img {
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    border-radius: 40% 60% 55% 45% / 45% 40% 60% 55%;
  }

  .oak-bleed {
    width: 100%;
    max-height: 42vh;
    overflow: hidden;
  }

  .oak-bleed img {
    width: 100%;
    height: 42vh;
    object-fit: cover;
    display: block;
  }

  .oak-bleed-alt {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    max-height: none;
  }

  .oak-bleed-alt img {
    height: 36vh;
  }

  .oak-split {
    display: grid;
    gap: 2.5rem;
    padding: 3.5rem 1.35rem;
    max-width: 78rem;
    margin: 0 auto;
  }

  @media (min-width: 960px) {
    .oak-split {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 4.5rem;
      align-items: start;
    }
  }

  .oak-col-wide h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .oak-lead {
    margin: 1rem 0 2rem;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 46ch;
  }

  .oak-group + .oak-group {
    margin-top: 2.25rem;
  }

  .oak-group h3 {
    margin: 0 0 0.85rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-accent) 75%, white);
  }

  .oak-line {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.95rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .oak-line strong {
    display: block;
    font-size: 1.05rem;
  }

  .oak-line p {
    margin: 0.3rem 0 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .oak-line span {
    white-space: nowrap;
    font-weight: 700;
    color: var(--color-accent);
  }

  .oak-pane {
    padding: 1.5rem;
    border-radius: 1.75rem;
    background: color-mix(in srgb, var(--color-surface) 80%, white 8%);
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  @media (min-width: 960px) {
    .oak-pane {
      position: sticky;
      top: 5rem;
    }
  }

  .oak-pane h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.6rem;
  }

  .oak-pane ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .oak-pane li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    font-size: 0.9rem;
  }

  .oak-note,
  .oak-addr {
    margin: 1rem 0 0;
    color: var(--color-muted);
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .oak-addr a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 700;
  }

  .oak-pane iframe {
    width: 100%;
    min-height: 180px;
    border: 0;
    border-radius: 1rem;
    margin-top: 1.15rem;
  }
</style>
