---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const telHref = `tel:${config.phone.replace(/\s/g, '')}`;
const ctaHref = config.reservationUrl ?? telHref;
const year = new Date().getFullYear();

let treatmentIndex = 0;
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="kc">
    <header class="kc-header">
      <div class="kc-header-rule" aria-hidden="true" />
      <div class="kc-header-inner">
        <a class="kc-wordmark" href={`/${lang}/${config.slug}`}>
          <span class="kc-wordmark-line">Kapsalon</span>
          <span class="kc-wordmark-line kc-wordmark-accent">Can</span>
        </a>
        <p class="kc-tagline">{content.tagline}</p>
      </div>
      <div class="kc-header-rule kc-header-rule--thick" aria-hidden="true" />
    </header>

    <section class="kc-hero">
      <div class="kc-hero-copy">
        <p class="kc-lead">{content.description}</p>
        <p class="kc-about">{content.about.content}</p>
        <a class="kc-hero-cta" href={ctaHref}>{content.ctaLabel}</a>
      </div>
      <figure class="kc-hero-photo">
        <img src={config.heroImage} alt="" width="800" height="600" />
      </figure>
    </section>

    <section class="kc-menu" id="behandelingen">
      <div class="kc-menu-block">
        <header class="kc-menu-head">
          <span class="kc-menu-num">01</span>
          <h2>{content.menuSectionLabel}</h2>
        </header>

        {content.menu.map((cat) => (
          <div class="kc-cat">
            <h3 class="kc-cat-title">{cat.name}</h3>
            <ul class="kc-rows">
              {cat.items.map((item) => {
                treatmentIndex += 1;
                const num = String(treatmentIndex).padStart(2, '0');
                return (
                  <li class="kc-row">
                    <span class="kc-row-num">{num}</span>
                    <div class="kc-row-body">
                      <span class="kc-row-name">{item.name}</span>
                      {item.description && (
                        <span class="kc-row-desc">{item.description}</span>
                      )}
                    </div>
                    <span class="kc-row-price">{item.price}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="kc-gallery" aria-label={t('gallery.title')}>
      <div class="kc-gallery-rule" aria-hidden="true" />
      <h2 class="kc-gallery-label">{t('gallery.title')}</h2>
      <div class="kc-gallery-grid">
        {config.gallery.map((src, i) => (
          <figure class={`kc-gallery-item kc-gallery-item--${i + 1}`}>
            <img src={src} alt="" loading="lazy" width="400" height="500" />
          </figure>
        ))}
      </div>
    </section>

    <section class="kc-bottom" id="contact">
      <div class="kc-bottom-inner">
        <div class="kc-bottom-info">
          <h2>{t('contact.visitUs')}</h2>
          <address class="kc-address">
            {config.address.street}<br />
            {config.address.postalCode} {config.address.city}
          </address>
          <div class="kc-contact-links">
            <a href={telHref}>{config.phone}</a>
            <a href={`mailto:${config.email}`}>{config.email}</a>
          </div>

          <h3>{t('hours.title')}</h3>
          <ul class="kc-hours">
            {content.openingHours.map((hour) => {
              const row = formatOpeningHours(t, hour);
              return (
                <li>
                  <span>{row.label}</span>
                  <span>{row.value}</span>
                </li>
              );
            })}
          </ul>
        </div>

        <div class="kc-bottom-action">
          <a class="kc-call-btn" href={ctaHref}>
            <span class="kc-call-btn-label">{content.ctaLabel}</span>
            <span class="kc-call-btn-phone">{config.phone}</span>
          </a>
          <iframe
            class="kc-map"
            title={`${config.name} kaart`}
            src={config.googleMapsEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      </div>
    </section>

    <footer class="kc-foot">
      <p>&copy; {year} {config.name}. {t('footer.rights')}</p>
    </footer>

    <div class="kc-mobile-bar">
      <a href={ctaHref}>
        <span>{content.ctaLabel}</span>
        <strong>{config.phone}</strong>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .kc {
    padding-bottom: 4.5rem;
  }

  /* ── Header / wordmark ── */
  .kc-header {
    padding: 1.25rem 1.25rem 0;
  }

  .kc-header-rule {
    height: 3px;
    background: var(--color-text);
  }

  .kc-header-rule--thick {
    height: 6px;
    margin-top: 1rem;
    background: var(--color-accent);
  }

  .kc-header-inner {
    padding: 1.25rem 0 0.5rem;
  }

  .kc-wordmark {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    line-height: 0.88;
  }

  .kc-wordmark-line {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 14vw, 8rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .kc-wordmark-accent {
    color: var(--color-accent);
    margin-top: -0.08em;
  }

  .kc-tagline {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* ── Hero ── */
  .kc-hero {
    display: grid;
    gap: 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 2.5rem;
  }

  @media (min-width: 768px) {
    .kc-hero {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 2.5rem;
      padding: 2.5rem 1.25rem 3rem;
    }
  }

  .kc-lead {
    margin: 0;
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
    font-weight: 600;
    line-height: 1.35;
    max-width: 28ch;
  }

  .kc-about {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 36ch;
  }

  .kc-hero-cta {
    display: inline-flex;
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-text);
    color: var(--color-background);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .kc-hero-photo {
    margin: 0;
    position: relative;
    overflow: hidden;
    border: 4px solid var(--color-text);
  }

  .kc-hero-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(40%) contrast(1.08);
  }

  .kc-hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    pointer-events: none;
  }

  /* ── Menu block ── */
  .kc-menu {
    padding: 0 1.25rem 3rem;
  }

  .kc-menu-block {
    max-width: 52rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 2.5rem;
    background: var(--color-accent);
    color: var(--color-on-primary-text);
  }

  .kc-menu-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 4px solid color-mix(in srgb, var(--color-on-primary-text) 35%, transparent);
  }

  .kc-menu-num {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    opacity: 0.45;
  }

  .kc-menu-head h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .kc-cat {
    margin-top: 2rem;
  }

  .kc-cat-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .kc-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid color-mix(in srgb, var(--color-on-primary-text) 25%, transparent);
  }

  .kc-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.75rem 1rem;
    align-items: start;
    padding: 0.85rem 0;
    border-bottom: 2px solid color-mix(in srgb, var(--color-on-primary-text) 20%, transparent);
  }

  .kc-row-num {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    opacity: 0.5;
    padding-top: 0.1rem;
  }

  .kc-row-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .kc-row-name {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .kc-row-desc {
    font-size: 0.85rem;
    opacity: 0.7;
    line-height: 1.4;
  }

  .kc-row-price {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    white-space: nowrap;
    text-align: right;
  }

  /* ── Gallery ── */
  .kc-gallery {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
  }

  .kc-gallery-rule {
    height: 6px;
    background: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .kc-gallery-label {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .kc-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .kc-gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.65rem;
    }
  }

  .kc-gallery-item {
    margin: 0;
    overflow: hidden;
    border: 3px solid var(--color-text);
    aspect-ratio: 3 / 4;
  }

  .kc-gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.15);
    mix-blend-mode: multiply;
    opacity: 0.85;
  }

  .kc-gallery-item--2 img,
  .kc-gallery-item--4 img {
    filter: grayscale(100%) contrast(1.15) sepia(30%) hue-rotate(180deg) saturate(2);
    opacity: 0.9;
  }

  /* ── Bottom contact block ── */
  .kc-bottom {
    background: var(--color-text);
    color: var(--color-background);
    padding: 2.5rem 1.25rem 3rem;
  }

  .kc-bottom-inner {
    display: grid;
    gap: 2rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .kc-bottom-inner {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
      gap: 3rem;
    }
  }

  .kc-bottom-info h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .kc-bottom-info h3 {
    margin: 1.75rem 0 0.65rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-background) 65%, transparent);
  }

  .kc-address {
    margin: 1rem 0 0;
    font-style: normal;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .kc-contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.85rem;
  }

  .kc-contact-links a {
    color: var(--color-background);
    text-decoration: none;
    font-weight: 600;
  }

  .kc-hours {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kc-hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-background) 20%, transparent);
    font-size: 0.95rem;
  }

  .kc-hours li span:last-child {
    color: color-mix(in srgb, var(--color-background) 75%, transparent);
  }

  .kc-call-btn {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.5rem 1.75rem;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .kc-call-btn-label {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .kc-call-btn-phone {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  .kc-map {
    width: 100%;
    min-height: 220px;
    border: 3px solid color-mix(in srgb, var(--color-background) 30%, transparent);
    filter: grayscale(30%) contrast(1.05);
  }

  /* ── Footer ── */
  .kc-foot {
    padding: 1.25rem;
    text-align: center;
    border-top: 3px solid var(--color-text);
  }

  .kc-foot p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  /* ── Mobile call bar ── */
  .kc-mobile-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    padding: 0.65rem 1rem calc(0.65rem + env(safe-area-inset-bottom, 0px));
    background: var(--color-accent);
    border-top: 3px solid var(--color-text);
  }

  .kc-mobile-bar a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-on-accent-text);
    text-decoration: none;
  }

  .kc-mobile-bar span {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .kc-mobile-bar strong {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
  }

  @media (min-width: 640px) {
    .kc {
      padding-bottom: 0;
    }

    .kc-mobile-bar {
      display: none;
    }
  }
</style>
