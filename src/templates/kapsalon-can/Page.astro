---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const telHref = `tel:${config.phone.replace(/\s/g, '')}`;
const ctaHref = config.reservationUrl ?? telHref;
const year = new Date().getFullYear();
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="kc">
    <header class="kc-top">
      <a class="kc-brand" href={`/${lang}/${config.slug}`}>
        {config.logo && <img class="kc-brand-logo" src={config.logo} alt="" width="128" height="40" />}
        <span class="kc-brand-name">{config.name}</span>
      </a>
      <a class="kc-top-phone" href={telHref}>{config.phone}</a>
    </header>

    <section class="kc-intro">
      <div class="kc-intro-copy">
        <p class="kc-kicker">{content.tagline}</p>
        <h1>{content.about.heading}</h1>
        <p class="kc-lead">{content.description}</p>
        <a class="kc-cta" href={ctaHref}>{content.ctaLabel}</a>
      </div>
      <figure class="kc-intro-photo">
        <img src={config.heroImage} alt="" width="800" height="600" />
      </figure>
    </section>

    <section class="kc-services" id="behandelingen">
      <h2 class="kc-h2">{content.menuSectionLabel}</h2>

      <div class="kc-cats">
        {content.menu.map((cat) => (
          <div class="kc-cat">
            <h3 class="kc-cat-title">{cat.name}</h3>
            <dl class="kc-rows">
              {cat.items.map((item) => (
                <div class="kc-row">
                  <dt>
                    <span class="kc-row-name">{item.name}</span>
                    {item.description && <span class="kc-row-desc">{item.description}</span>}
                  </dt>
                  <dd>{item.price}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <section class="kc-photos" aria-label={t('gallery.title')}>
      {config.gallery.map((src) => (
        <figure>
          <img src={src} alt="" loading="lazy" width="400" height="400" />
        </figure>
      ))}
    </section>

    <section class="kc-visit" id="contact">
      <div class="kc-visit-info">
        <h2 class="kc-h2">{t('contact.visitUs')}</h2>
        <address>
          {config.address.street}<br />
          {config.address.postalCode} {config.address.city}
        </address>
        <p class="kc-links">
          <a href={telHref}>{config.phone}</a>
          <a href={`mailto:${config.email}`}>{config.email}</a>
        </p>

        <h3 class="kc-h3">{t('hours.title')}</h3>
        <ul class="kc-hours">
          {content.openingHours.map((hour) => {
            const row = formatOpeningHours(t, hour);
            return (
              <li>
                <span>{row.label}</span>
                <span>{row.value}</span>
              </li>
            );
          })}
        </ul>
        {content.bookingNote && <p class="kc-note">{content.bookingNote}</p>}
      </div>

      <iframe
        class="kc-map"
        title={`${config.name} kaart`}
        src={config.googleMapsEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </section>

    <footer class="kc-foot">
      <p>&copy; {year} {config.name}</p>
    </footer>

    <div class="kc-callbar">
      <a href={ctaHref}>{content.ctaLabel} · {config.phone}</a>
    </div>
  </div>
</BaseLayout>

<style>
  .kc {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 1.25rem 5rem;
  }

  .kc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
  }

  .kc-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .kc-brand-logo {
    height: 2rem;
    width: auto;
    flex: none;
  }

  .kc-brand-name {
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kc-top-phone {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 2.75rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  /* ── Intro ── */
  .kc-intro {
    display: grid;
    gap: 1.75rem;
    padding: 2.25rem 0 2.5rem;
  }

  .kc-kicker {
    margin: 0 0 0.75rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .kc-intro-copy h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 5.2vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .kc-lead {
    margin: 0.9rem 0 0;
    max-width: 42ch;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .kc-cta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.8rem 1.4rem;
    border-radius: 2px;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .kc-intro-photo {
    margin: 0;
    overflow: hidden;
    border-radius: 3px;
  }

  .kc-intro-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 800px) {
    .kc-intro {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 2.75rem;
      padding: 3rem 0 3.25rem;
    }
  }

  /* ── Services ── */
  .kc-h2 {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .kc-services {
    padding: 1.75rem 0 2.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
  }

  .kc-cats {
    display: grid;
    gap: 2.25rem;
  }

  @media (min-width: 800px) {
    .kc-cats {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 3rem;
    }
  }

  .kc-cat-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .kc-rows {
    margin: 0;
  }

  .kc-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  .kc-row dt {
    min-width: 0;
  }

  .kc-row dd {
    margin: 0;
    flex: none;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .kc-row-name {
    display: block;
    font-size: 1rem;
    line-height: 1.35;
  }

  .kc-row-desc {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  /* ── Photos ── */
  .kc-photos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .kc-photos {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .kc-photos figure {
    margin: 0;
    overflow: hidden;
    border-radius: 3px;
  }

  .kc-photos img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* ── Visit ── */
  .kc-visit {
    display: grid;
    gap: 1.75rem;
    padding: 1.75rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
  }

  @media (min-width: 800px) {
    .kc-visit {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .kc-visit address {
    font-style: normal;
    font-size: 1rem;
    line-height: 1.6;
  }

  .kc-links {
    display: flex;
    flex-direction: column;
    margin: 0.6rem 0 0;
  }

  .kc-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .kc-note {
    margin: 0.85rem 0 0;
    max-width: 30rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .kc-h3 {
    margin: 1.75rem 0 0.6rem;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .kc-hours {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 24rem;
  }

  .kc-hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.42rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    font-size: 0.95rem;
  }

  .kc-hours li span:last-child {
    color: var(--color-muted);
  }

  .kc-map {
    width: 100%;
    min-height: 260px;
    border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
    border-radius: 3px;
  }

  .kc-foot {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
  }

  .kc-foot p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  /* ── Mobile call bar ── */
  .kc-callbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
    background: var(--color-accent);
    text-align: center;
  }

  .kc-callbar a {
    display: block;
    padding: 0.35rem 0;
    color: var(--color-on-accent-text);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .kc {
      padding-bottom: 2.5rem;
    }

    .kc-callbar {
      display: none;
    }
  }
</style>
