---
import type { SiteConfig } from '../../types/site-config';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../components/shared/LanguageSwitcher.astro';
import Footer from '../../components/shared/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningHours } from '../../utils/hours';

interface Props {
  config: SiteConfig;
  lang: Lang;
}

const { config, lang } = Astro.props;
const content = config.content[lang];
const t = useTranslations(lang);
const telHref = `tel:${config.phone.replace(/\s/g, '')}`;
const whatsappHref =
  config.reservationUrl?.startsWith('https://wa.me/')
    ? config.reservationUrl
    : `https://wa.me/${config.phone.replace(/\D/g, '')}`;
const media = [config.heroImage, config.aboutImage, ...config.gallery].filter(Boolean) as string[];
const chapters = [
  {
    id: 'intro',
    title: content.tagline,
    body: content.description,
    media: media[0],
  },
  {
    id: 'about',
    title: content.about.heading,
    body: content.about.content,
    media: media[1] ?? media[0],
  },
  {
    id: 'services',
    title: content.menuSectionLabel ?? t('menu.title'),
    body: content.bookingNote ?? '',
    media: media[2] ?? media[0],
    services: true as const,
  },
  {
    id: 'visit',
    title: t('contact.visitUs'),
    body: `${config.address.street}, ${config.address.postalCode} ${config.address.city}`,
    media: media[3] ?? media[0],
    visit: true as const,
  },
];
---

<BaseLayout config={config} content={content} lang={lang} canonicalPath={`/${lang}/${config.slug}`}>
  <div class="ax" data-archetype="sticky-split-viewport">
    <header class="ax-top">
      <a href={`/${lang}/${config.slug}`}>{config.name}</a>
      <div class="ax-top-actions">
        <a href={telHref}>{t('cta.callNow')}</a>
        <LanguageSwitcher lang={lang} slug={config.slug} variant="dark" />
      </div>
    </header>

    <div class="ax-stage">
      <div class="ax-copy">
        {chapters.map((chapter) => (
          <section class="ax-chapter" id={chapter.id} data-ax-chapter>
            <p class="ax-kicker">{config.name}</p>
            <h1>{chapter.title}</h1>
            {chapter.body && <p class="ax-body">{chapter.body}</p>}
            <img class="ax-mobile-media" src={chapter.media} alt="" loading="lazy" />

            {'services' in chapter && chapter.services && (
              <div class="ax-services">
                {content.menu.map((cat) => (
                  <div>
                    <h2>{cat.name}</h2>
                    <ul>
                      {cat.items.map((item) => (
                        <li>
                          <div>
                            <strong>{item.name}</strong>
                            <span>{item.description}</span>
                          </div>
                          <em>{item.price}</em>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}

            {'visit' in chapter && chapter.visit && (
              <div class="ax-visit">
                <ul>
                  {content.openingHours.map((hour) => {
                    const row = formatOpeningHours(t, hour);
                    return (
                      <li>
                        <span>{row.label}</span>
                        <span>{row.value}</span>
                      </li>
                    );
                  })}
                </ul>
                <div class="ax-cta">
                  <a href={telHref}>{t('cta.callNow')}</a>
                  <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
                </div>
                <iframe
                  title={`${config.name} map`}
                  src={config.googleMapsEmbed}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                />
              </div>
            )}
          </section>
        ))}
      </div>

      <aside class="ax-media" aria-hidden="true">
        <div class="ax-media-frame">
          {chapters.map((chapter, i) => (
            <img
              class:list={['ax-slide', { 'is-active': i === 0 }]}
              src={chapter.media}
              alt=""
              data-ax-slide={chapter.id}
            />
          ))}
        </div>
        <div class="ax-media-dots">
          {chapters.map((chapter, i) => (
            <button type="button" class:list={[{ 'is-active': i === 0 }]} data-ax-dot={chapter.id} aria-label={chapter.title} />
          ))}
        </div>
      </aside>
    </div>

    <Footer config={config} lang={lang} />
  </div>

  <script>
    const chapters = Array.from(document.querySelectorAll('[data-ax-chapter]'));
    const slides = Array.from(document.querySelectorAll('[data-ax-slide]'));
    const dots = Array.from(document.querySelectorAll('[data-ax-dot]'));

    const activate = (id: string) => {
      slides.forEach((el) => el.classList.toggle('is-active', el.getAttribute('data-ax-slide') === id));
      dots.forEach((el) => el.classList.toggle('is-active', el.getAttribute('data-ax-dot') === id));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target instanceof HTMLElement) {
          activate(visible.target.id);
        }
      },
      { root: null, threshold: [0.35, 0.55, 0.7], rootMargin: '-20% 0px -30% 0px' }
    );

    chapters.forEach((el) => observer.observe(el));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const id = dot.getAttribute('data-ax-dot');
        if (!id) return;
        document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  </script>
</BaseLayout>

<style>
  .ax-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.15rem;
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-background) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .ax-top > a {
    font-family: var(--font-heading);
    text-decoration: none;
    color: var(--color-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .ax-top-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .ax-top-actions > a {
    display: none;
    text-decoration: none;
    color: var(--color-on-accent-text);
    background: var(--color-accent);
    padding: 0.55rem 0.9rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (min-width: 700px) {
    .ax-top-actions > a { display: inline-flex; }
  }

  .ax-stage {
    display: grid;
  }

  @media (min-width: 980px) {
    .ax-stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: calc(100vh - 3.4rem);
    }
  }

  .ax-copy {
    padding: 0 1.15rem 4rem;
  }

  .ax-chapter {
    padding: 18vh 0 18vh;
    max-width: 34rem;
  }

  .ax-chapter:first-child {
    padding-top: 8vh;
  }

  @media (max-width: 979px) {
    .ax-chapter {
      padding: 2.5rem 0;
    }
  }

  .ax-kicker {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 800;
  }

  .ax-chapter h1 {
    margin: 0.7rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 0.98;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .ax-body {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .ax-mobile-media {
    display: block;
    width: 100%;
    height: 38vw;
    max-height: 240px;
    object-fit: cover;
    margin-top: 1.35rem;
    border-radius: 0 1.5rem 0 1.5rem;
  }

  @media (min-width: 980px) {
    .ax-mobile-media { display: none; }
  }

  .ax-services {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.75rem;
  }

  .ax-services h2 {
    margin: 0 0 0.65rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .ax-services ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ax-services li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .ax-services strong {
    display: block;
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-size: 1rem;
  }

  .ax-services span {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .ax-services em {
    font-style: normal;
    color: var(--color-accent);
    font-weight: 700;
    white-space: nowrap;
  }

  .ax-visit ul {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .ax-visit li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    font-size: 0.92rem;
  }

  .ax-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 1.25rem 0;
  }

  .ax-cta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.85rem;
    padding: 0.7rem 1.1rem;
    background: var(--color-accent);
    color: var(--color-on-accent-text);
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8rem;
  }

  .ax-cta a:last-child {
    background: transparent;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
  }

  .ax-visit iframe {
    width: 100%;
    min-height: 220px;
    border: 0;
  }

  .ax-media {
    display: none;
  }

  @media (min-width: 980px) {
    .ax-media {
      display: block;
      position: sticky;
      top: 3.4rem;
      height: calc(100vh - 3.4rem);
      padding: 1rem 1rem 1rem 0;
    }
  }

  .ax-media-frame {
    position: relative;
    height: calc(100% - 2.5rem);
    overflow: hidden;
    border-radius: 0 0 0 3rem;
  }

  .ax-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: translateY(4%);
    transition: opacity 0.45s ease, transform 0.55s ease;
  }

  .ax-slide.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .ax-media-dots {
    display: flex;
    gap: 0.45rem;
    justify-content: center;
    margin-top: 0.85rem;
  }

  .ax-media-dots button {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    border: 0;
    background: color-mix(in srgb, var(--color-text) 25%, transparent);
    cursor: pointer;
    padding: 0;
  }

  .ax-media-dots button.is-active {
    background: var(--color-accent);
    width: 1.4rem;
  }
</style>
