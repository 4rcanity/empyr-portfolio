---
import '../../styles/global.css';
import { languages, type Lang } from '../../i18n/ui';
import PortfolioSEO from '../../components/shared/PortfolioSEO.astro';
import LocaleRedirect from '../../components/shared/LocaleRedirect.astro';
import DisciplineNav from '../../components/shared/DisciplineNav.astro';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const copy =
  lang === 'nl'
    ? {
        title: 'Empyr Minigames',
        description: 'Korte browsergames en speelbare experimenten van Empyr.',
        status: 'Speelbaar',
        heading: 'Browsergames',
        frenzyTitle: 'HI/LO Frenzy',
        frenzyBody:
          'Private kamers, wildcards, ace-kaarten, eliminaties, beurtklok en live shuffle-stemmen. Minimaal 3 spelers.',
        frenzyCta: 'Speel Frenzy',
        frenzyBadge: 'Multiplayer',
        unoTitle: 'EMPYR UNO',
        unoBody:
          'Volledige UNO-tafel voor 2 tot 10 spelers, met vijf uitbreidingen: Flip, No Mercy, All Wild, Attack en House Rules.',
        unoCta: 'Speel UNO',
        monoTitle: 'EMPYR Ledger',
        monoBody:
          'Bordspel met straten, veilingen, ruilhandel, hypotheken, huizen, hotels en faillissementen. 2 tot 8 spelers.',
        monoCta: 'Speel Ledger',
        wordTitle: 'EMPYR Wordsearch',
        wordBody: 'Gedeeld woordrooster — wie een woord eerst vindt, claimt het. Race tegen anderen op dezelfde grid.',
        wordCta: 'Speel Wordsearch',
        gooseTitle: 'Ganzenbord',
        gooseBody: 'Klassiek Nederlands ganzenbord met een strafvenster dat uitlegt wat er gebeurt als je een tegel raakt.',
        gooseCta: 'Speel Ganzenbord',
        mensTitle: 'Mens erger je niet',
        mensBody: 'Pionnen, dobbelstenen en het classic race-naar-huis — speelbaar in de browser.',
        mensCta: 'Speel Mens',
        aimTitle: 'RANGE-07',
        aimBody: 'Aim trainer met Valorant-achtige cm/360-instellingen. Solo, geen server nodig.',
        aimCta: 'Open RANGE-07',
        chessTitle: 'Empyr Gambit',
        chessBody: 'Klassiek schaken met klok, promotie, remise-claims en PGN — 1v1 op een eigen realtime server.',
        chessCta: 'Speel Schaak',
        draughtsTitle: 'Draughts',
        draughtsBody: 'Internationaal dammen 10×10 met verplichte slagen, multi-captures en dam-promotie.',
        draughtsCta: 'Speel Dammen',
        soloBadge: 'Solo',
        more: 'Meer minigames volgen.',
      }
    : {
        title: 'Empyr Minigames',
        description: 'Short browser games and playable experiments from Empyr.',
        status: 'Playable',
        heading: 'Browser Games',
        frenzyTitle: 'HI/LO Frenzy',
        frenzyBody:
          'Private rooms, wildcards, ace cards, eliminations, a turn clock and live shuffle votes. Minimum 3 players.',
        frenzyCta: 'Play Frenzy',
        frenzyBadge: 'Multiplayer',
        unoTitle: 'EMPYR UNO',
        unoBody:
          'A full UNO table for 2 to 10 players, with five expansions: Flip, No Mercy, All Wild, Attack and House Rules.',
        unoCta: 'Play UNO',
        monoTitle: 'EMPYR Ledger',
        monoBody:
          'Property board game with auctions, trading, mortgages, houses, hotels and bankruptcies. 2 to 8 players.',
        monoCta: 'Play Ledger',
        wordTitle: 'EMPYR Wordsearch',
        wordBody: 'Shared word grid — first to find a word claims it. Race others on the same board.',
        wordCta: 'Play Wordsearch',
        gooseTitle: 'Ganzenbord',
        gooseBody: 'Classic Dutch goose board with a punishment window that explains what a square does to you.',
        gooseCta: 'Play Ganzenbord',
        mensTitle: 'Mens erger je niet',
        mensBody: 'Pawns, dice, and the classic race home — playable in the browser.',
        mensCta: 'Play Mens',
        aimTitle: 'RANGE-07',
        aimBody: 'Aim trainer with Valorant-style cm/360 settings. Solo — no server required.',
        aimCta: 'Open RANGE-07',
        chessTitle: 'Empyr Gambit',
        chessBody: 'Classic chess with clocks, promotion, draw claims and PGN — 1v1 on its own realtime server.',
        chessCta: 'Play Chess',
        draughtsTitle: 'Draughts',
        draughtsBody: 'International draughts 10×10 with forced captures, multi-capture chains and king promotion.',
        draughtsCta: 'Play Draughts',
        soloBadge: 'Solo',
        more: 'More minigames coming soon.',
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <PortfolioSEO lang={lang} title={copy.title} description={copy.description} path="/minigames" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <LocaleRedirect lang={lang} />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[#08080b] text-white antialiased" style="font-family: Inter, system-ui, sans-serif;">
    <div class="fixed inset-0 -z-10">
      <div class="absolute left-1/2 top-[-18rem] h-[38rem] w-[38rem] -translate-x-1/2 rounded-full bg-cyan-500/20 blur-[120px]"></div>
      <div class="absolute bottom-[-16rem] right-[-8rem] h-[32rem] w-[32rem] rounded-full bg-teal-500/10 blur-[120px]"></div>
    </div>

    <header class="border-b border-white/10 bg-black/10 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href={`/${lang}`} class="flex items-center gap-2.5 text-lg font-extrabold tracking-tight text-white">
          <img src="/images/empyr-logo.png" alt="Empyr" class="h-9 w-9 rounded-xl object-cover" width="36" height="36" />
          Empyr
        </a>
        <div class="flex items-center gap-3">
          <DisciplineNav lang={lang} current="minigames" />
          <span class="hidden rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-cyan-300 sm:inline-flex">
            {copy.status}
          </span>
          <div class="flex items-center gap-1 rounded-full border border-white/10 bg-white/[0.04] p-1 text-xs font-semibold">
            {languages.map((l) => (
              <a
                href={`/${l}/minigames`}
                class="rounded-full px-3 py-1 transition-colors"
                style={l === lang ? 'background: white; color: #18181b;' : 'color: #a1a1aa;'}
              >
                {l.toUpperCase()}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <section class="max-w-3xl">
        <h1 class="text-5xl font-semibold leading-[0.95] tracking-[-0.06em] sm:text-7xl">{copy.heading}</h1>
      </section>

      <section class="mt-14 grid gap-4 md:grid-cols-2">
        <a
          href={`/${lang}/minigames/frenzy`}
          class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 transition duration-500 hover:-translate-y-1 hover:border-cyan-400/45 sm:p-9"
        >
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-cyan-500/20 blur-3xl transition group-hover:bg-cyan-500/30"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-500 text-white shadow-lg shadow-cyan-500/25">
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M7 8h10M7 12h6M7 16h8" stroke-linecap="round"></path>
                  <rect x="4" y="4" width="16" height="16" rx="3"></rect>
                </svg>
              </span>
              <span class="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-cyan-300">
                {copy.frenzyBadge}
              </span>
            </div>
            <h2 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.frenzyTitle}</h2>
            <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400">{copy.frenzyBody}</p>
            <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-cyan-300">
              {copy.frenzyCta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <a
          href={`/${lang}/minigames/uno`}
          class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 transition duration-500 hover:-translate-y-1 hover:border-pink-400/45 sm:p-9"
        >
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-pink-500/20 blur-3xl transition group-hover:bg-pink-500/30"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-pink-500 text-white shadow-lg shadow-pink-500/25">
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="5" width="11" height="15" rx="2.5"></rect>
                  <path d="M16.5 6.4 20 7.6a2 2 0 0 1 1.2 2.6l-3.6 9.3" stroke-linecap="round"></path>
                  <path d="M8.5 9.5v6" stroke-linecap="round"></path>
                </svg>
              </span>
              <span class="rounded-full border border-pink-400/20 bg-pink-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-pink-300">
                {copy.frenzyBadge}
              </span>
            </div>
            <h2 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.unoTitle}</h2>
            <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400">{copy.unoBody}</p>
            <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-pink-300">
              {copy.unoCta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <a
          href={`/${lang}/minigames/monopoly`}
          class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 transition duration-500 hover:-translate-y-1 hover:border-emerald-400/45 sm:p-9 md:col-span-2"
        >
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-emerald-500/20 blur-3xl transition group-hover:bg-emerald-500/30"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500 text-white shadow-lg shadow-emerald-500/25">
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2.5"></rect>
                  <path d="M8 3v18M3 8h18M16 3v18M3 16h18" stroke-linecap="round"></path>
                </svg>
              </span>
              <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-emerald-300">
                {copy.frenzyBadge}
              </span>
            </div>
            <h2 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.monoTitle}</h2>
            <p class="mt-3 max-w-xl text-sm leading-6 text-zinc-400">{copy.monoBody}</p>
            <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-emerald-300">
              {copy.monoCta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <a
          href={`/${lang}/minigames/wordsearch`}
          class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 transition duration-500 hover:-translate-y-1 hover:border-amber-400/45 sm:p-9"
        >
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-amber-500/20 blur-3xl transition group-hover:bg-amber-500/30"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500 text-white shadow-lg shadow-amber-500/25">
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <circle cx="11" cy="11" r="6.5"></circle>
                  <path d="m16 16 4 4" stroke-linecap="round"></path>
                </svg>
              </span>
              <span class="rounded-full border border-amber-400/20 bg-amber-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-300">
                {copy.frenzyBadge}
              </span>
            </div>
            <h2 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.wordTitle}</h2>
            <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400">{copy.wordBody}</p>
            <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-amber-300">
              {copy.wordCta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <a
          href={`/${lang}/minigames/ganzenbord`}
          class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 transition duration-500 hover:-translate-y-1 hover:border-violet-400/45 sm:p-9"
        >
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-violet-500/20 blur-3xl transition group-hover:bg-violet-500/30"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-500 text-white shadow-lg shadow-violet-500/25">
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 19c3-1 5-4 5-7s-1-5-3-6c3 1 7 1 10-1 1 4-1 9-4 12-2 2-5 3-8 2z" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="rounded-full border border-violet-400/20 bg-violet-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-violet-300">
                {copy.frenzyBadge}
              </span>
            </div>
            <h2 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.gooseTitle}</h2>
            <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400">{copy.gooseBody}</p>
            <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-violet-300">
              {copy.gooseCta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <a
          href={`/${lang}/minigames/mens`}
          class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 transition duration-500 hover:-translate-y-1 hover:border-rose-400/45 sm:p-9"
        >
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-rose-500/20 blur-3xl transition group-hover:bg-rose-500/30"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-500 text-white shadow-lg shadow-rose-500/25">
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <circle cx="8" cy="8" r="2.5"></circle>
                  <circle cx="16" cy="8" r="2.5"></circle>
                  <circle cx="8" cy="16" r="2.5"></circle>
                  <circle cx="16" cy="16" r="2.5"></circle>
                </svg>
              </span>
              <span class="rounded-full border border-rose-400/20 bg-rose-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-rose-300">
                {copy.frenzyBadge}
              </span>
            </div>
            <h2 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.mensTitle}</h2>
            <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400">{copy.mensBody}</p>
            <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-rose-300">
              {copy.mensCta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <a
          href={`/${lang}/minigames/aim`}
          class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 transition duration-500 hover:-translate-y-1 hover:border-sky-400/45 sm:p-9"
        >
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-sky-500/20 blur-3xl transition group-hover:bg-sky-500/30"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-500 text-white shadow-lg shadow-sky-500/25">
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <circle cx="12" cy="12" r="8"></circle>
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke-linecap="round"></path>
                </svg>
              </span>
              <span class="rounded-full border border-sky-400/20 bg-sky-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-sky-300">
                {copy.soloBadge}
              </span>
            </div>
            <h2 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.aimTitle}</h2>
            <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400">{copy.aimBody}</p>
            <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-sky-300">
              {copy.aimCta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <a
          href={`/${lang}/minigames/chess`}
          class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 transition duration-500 hover:-translate-y-1 hover:border-yellow-400/45 sm:p-9"
        >
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-yellow-500/20 blur-3xl transition group-hover:bg-yellow-500/30"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-yellow-600 text-white shadow-lg shadow-yellow-600/25">
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M8 20h8M10 20V9l-2-2h8l-2 2v11M12 4v3M9 7h6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="rounded-full border border-yellow-400/20 bg-yellow-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-yellow-200">
                {copy.frenzyBadge}
              </span>
            </div>
            <h2 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.chessTitle}</h2>
            <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400">{copy.chessBody}</p>
            <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-yellow-200">
              {copy.chessCta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <a
          href={`/${lang}/minigames/draughts`}
          class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.05] p-7 transition duration-500 hover:-translate-y-1 hover:border-orange-400/45 sm:p-9"
        >
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-orange-500/20 blur-3xl transition group-hover:bg-orange-500/30"></div>
          <div class="relative">
            <div class="flex items-center justify-between gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-500 text-white shadow-lg shadow-orange-500/25">
                <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <circle cx="8" cy="8" r="2.2"></circle>
                  <circle cx="16" cy="8" r="2.2"></circle>
                  <circle cx="12" cy="14" r="2.2"></circle>
                  <circle cx="8" cy="18" r="2.2"></circle>
                  <circle cx="16" cy="18" r="2.2"></circle>
                </svg>
              </span>
              <span class="rounded-full border border-orange-400/20 bg-orange-400/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-orange-300">
                {copy.frenzyBadge}
              </span>
            </div>
            <h2 class="mt-10 text-2xl font-semibold tracking-tight text-white sm:text-3xl">{copy.draughtsTitle}</h2>
            <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400">{copy.draughtsBody}</p>
            <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-orange-300">
              {copy.draughtsCta}
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </section>
    </main>
  </body>
</html>
