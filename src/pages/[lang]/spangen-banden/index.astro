---
import Page from '../../../templates/spangen-banden/Page.astro';
import { spangenBandenConfig } from '../../../data/spangen-banden-config';
import { languages, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<Page config={spangenBandenConfig} lang={lang} />
