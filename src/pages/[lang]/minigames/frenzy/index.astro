---
import '../../../../styles/global.css';
import '../../../../games/hilo/hilo.css';
import { languages, type Lang } from '../../../../i18n/ui';
import PortfolioSEO from '../../../../components/shared/PortfolioSEO.astro';
import LocaleRedirect from '../../../../components/shared/LocaleRedirect.astro';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const copy =
  lang === 'nl'
    ? {
        title: 'HI/LO Frenzy — Empyr Minigames',
        description: 'Multiplayer bluf- en eliminatiegame in de browser. Maak een tafel en nodig je vrienden uit.',
        eyebrow: 'Empyr / Minigames',
        lead: 'Eén verstopt getal. Iedereen roept hoger of lager. Wie ernaast zit, ligt eruit.',
        stepsTitle: 'Hoe het werkt',
        steps: [
          'De kiezers verstoppen elk een getal binnen het bereik. Eén daarvan wordt het echte doel.',
          'De eerste speler legt een willekeurig getal op tafel.',
          'Daarna roept iedereen om beurten hoger of lager en geeft een nieuw getal door binnen het gekrompen venster.',
          'Fout geroepen of precies op het doel landen betekent eliminatie. De overlevenden krijgen elke keer een extra kaart.',
        ],
        cardsTitle: 'Kaarten',
        cards: [
          ['⟲', 'Omkeren', 'Draai de beurtrichting om'],
          ['⇥', 'Overslaan', 'Volgende speler verliest de beurt'],
          ['◈', 'Schild', 'Pas zonder te roepen'],
          ['☰', 'Bluf', 'Roep een valse richting om'],
          ['⌁', 'Vernauwen', 'Krimp het venster rond het midden'],
          ['◐', 'Blinddoek', 'Verberg alle getallen voor één rivaal'],
        ],
        createTitle: 'Nieuwe tafel',
        createBody: '3 tot 10 spelers. Je krijgt een kamercode die je kunt delen.',
        create: 'Tafel openen',
        joinTitle: 'Tafel joinen',
        joinBody: 'Heb je een code van een vriend? Vul hem hier in.',
        joinPlaceholder: 'kamercode',
        join: 'Meedoen',
        back: 'Terug naar minigames',
      }
    : {
        title: 'HI/LO Frenzy — Empyr Minigames',
        description: 'Multiplayer bluffing and elimination game in the browser. Open a table and invite your friends.',
        eyebrow: 'Empyr / Minigames',
        lead: 'One hidden number. Everyone calls higher or lower. Get it wrong and you are out.',
        stepsTitle: 'How it runs',
        steps: [
          'Choosers each hide a number inside the range. One of them becomes the live target.',
          'The first player drops any number on the table.',
          'Everyone after that calls higher or lower, then hands the next number to the player after them.',
          'A wrong call — or landing exactly on the target — eliminates you. Survivors each draw a card.',
        ],
        cardsTitle: 'Cards',
        cards: [
          ['⟲', 'Reverse', 'Flip the turn direction'],
          ['⇥', 'Skip', 'Next player loses their turn'],
          ['◈', 'Shield', 'Pass without calling'],
          ['☰', 'Bluff', 'Broadcast a fake direction'],
          ['⌁', 'Narrow', 'Collapse the window around the middle'],
          ['◐', 'Blindfold', 'Hide every number from one rival'],
        ],
        createTitle: 'New table',
        createBody: '3 to 10 players. You get a room code to share.',
        create: 'Open a table',
        joinTitle: 'Join a table',
        joinBody: 'Got a code from a friend? Drop it in here.',
        joinPlaceholder: 'room code',
        join: 'Join',
        back: 'Back to minigames',
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <PortfolioSEO lang={lang} title={copy.title} description={copy.description} path="/minigames/frenzy" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <LocaleRedirect lang={lang} />
  </head>
  <body>
    <div class="hl">
      <div class="hl-wrap" style="padding-bottom: 5rem;">
        <header class="hl-bar">
          <div class="hl-logo">HI/LO<span> / FRENZY</span></div>
          <span class="hl-spacer"></span>
          <div class="flex items-center gap-1">
            {languages.map((l) => (
              <a class="hl-chip" href={`/${l}/minigames/frenzy`} style={l === lang ? 'color:#ffb020;border-color:#ffb020;' : ''}>
                {l.toUpperCase()}
              </a>
            ))}
          </div>
          <a class="hl-chip" href={`/${lang}/minigames`}>{copy.back}</a>
        </header>

        <section style="padding: clamp(2.5rem, 8vw, 5rem) 0 0;">
          <p class="hl-eyebrow">{copy.eyebrow}</p>
          <h1
            class="hl-mono"
            style="margin:0.6rem 0 0; font-size:clamp(2.6rem,12vw,7rem); line-height:0.9; font-weight:800; letter-spacing:-0.03em;"
          >
            HI<span style="color:var(--amber)">/</span>LO<br />FRENZY
          </h1>
          <p class="hl-sub" style="margin-top:1.2rem; font-size:1rem; max-width:44ch;">{copy.lead}</p>
        </section>

        <section class="hl-main" style="margin-top:2.5rem;">
          <div class="hl-panel">
            <p class="hl-eyebrow">{copy.createTitle}</p>
            <p class="hl-sub" style="margin-top:0.5rem;">{copy.createBody}</p>
            <button type="button" class="hl-btn" id="hl-create" style="margin-top:1.1rem; width:100%;">
              {copy.create}
            </button>

            <hr style="border:0; border-top:1px solid var(--line); margin:1.5rem 0;" />

            <p class="hl-eyebrow">{copy.joinTitle}</p>
            <p class="hl-sub" style="margin-top:0.5rem;">{copy.joinBody}</p>
            <form id="hl-join" style="margin-top:1.1rem; display:grid; gap:0.6rem;">
              <input
                id="hl-code"
                class="hl-input"
                placeholder={copy.joinPlaceholder}
                autocomplete="off"
                spellcheck="false"
                maxlength="24"
              />
              <button type="submit" class="hl-btn" data-ghost="true">{copy.join}</button>
            </form>
          </div>

          <div class="hl-feed" style="min-height:0;">
            <p class="hl-eyebrow">{copy.stepsTitle}</p>
            <ol style="list-style:none; margin:0.7rem 0 0; padding:0; display:grid; gap:0.7rem; counter-reset: step;">
              {copy.steps.map((step) => (
                <li
                  class="hl-mono"
                  style="font-size:0.72rem; line-height:1.55; color:var(--dim); border-left:2px solid var(--line); padding-left:0.6rem;"
                >
                  {step}
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section style="margin-top:1.5rem;">
          <p class="hl-eyebrow">{copy.cardsTitle}</p>
          <div style="margin-top:0.7rem; display:grid; gap:0.5rem; grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));">
            {copy.cards.map(([glyph, name, desc], index) => (
              <div class="hl-dial" data-kind={index > 3 ? 'ace' : 'wild'}>
                <div style="display:flex; align-items:center; gap:0.5rem;">
                  <span style="font-size:1.1rem; color:var(--amber);">{glyph}</span>
                  <span class="hl-mono" style="font-size:0.72rem; letter-spacing:0.12em; text-transform:uppercase;">{name}</span>
                </div>
                <p class="hl-mono" style="margin:0.35rem 0 0; font-size:0.62rem; line-height:1.4; color:var(--dim);">{desc}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <script is:inline define:vars={{ lang }}>
      (function () {
        var alphabet = 'abcdefghijkmnpqrstuvwxyz23456789';

        function go(code) {
          var clean = String(code || '')
            .toLowerCase()
            .replace(/[^a-z0-9-]/g, '')
            .slice(0, 24);
          if (!clean) return;
          location.href = '/' + lang + '/minigames/frenzy/play?code=' + encodeURIComponent(clean);
        }

        document.getElementById('hl-create').addEventListener('click', function () {
          var out = '';
          var bytes = new Uint32Array(6);
          window.crypto.getRandomValues(bytes);
          for (var i = 0; i < 6; i++) out += alphabet[bytes[i] % alphabet.length];
          go(out);
        });

        document.getElementById('hl-join').addEventListener('submit', function (event) {
          event.preventDefault();
          go(document.getElementById('hl-code').value);
        });
      })();
    </script>
  </body>
</html>
