---
import { languages, type Lang } from '../../../../i18n/ui';
import PortfolioSEO from '../../../../components/shared/PortfolioSEO.astro';
import LocaleRedirect from '../../../../components/shared/LocaleRedirect.astro';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const copy =
  lang === 'nl'
    ? {
        title: 'DAMCAFÉ — internationaal dammen online',
        description:
          'Speel internationaal dammen (10×10) online tegen een vriend. Slaan is verplicht, meerslag verplicht, vliegende dam, klok en zetlijst.',
        eyebrow: 'Empyr / Minigames',
        h1a: 'Twintig schijven.',
        h1b: 'Vijftig velden.',
        blurb:
          'Het Nederlandse spel op een echt bord van honderd velden. De server rekent elke slagzet uit, kent de maximumslag en laat je kiezen als er meerdere even lange routes zijn.',
        createTitle: 'Nieuw bord',
        createSub: 'Open een kamer en stuur de link door.',
        create: 'Bord openen',
        joinTitle: 'Meedoen',
        joinSub: 'Heb je een code gekregen?',
        joinPlaceholder: 'Kamercode',
        join: 'Meedoen',
        rulesTitle: 'Hoe het gaat',
        rules: [
          ['Slaan is verplicht', 'Ligt er een slagzet, dan moet je slaan. Schijven slaan vooruit én achteruit.'],
          ['De maximumslag', 'Van alle slagzetten speel je er één die het grootste aantal stukken pakt. Niets minder.'],
          ['Vliegende dam', 'Een dam loopt en slaat over de hele diagonaal, en jij kiest waar hij neerkomt.'],
          ['Dam op de laatste lijn', 'Eindig je slag op de overkant, dan word je dam. Alleen erlangs? Dan blijf je schijf.'],
        ],
        featTitle: 'Aan tafel',
        feats: [
          ['Klok met bonus', 'Optioneel, met increment per zet, en volledig op de server geklokt.'],
          ['Zetlijst in damnotatie', 'Velden 1 tot 50, × voor een slag. Klik terug door de partij en spring weer naar de stand.'],
          ['Routekiezer', 'Even veel stukken via een andere weg? Je kiest de route hop voor hop of uit de lijst.'],
          ['Kijkers welkom', 'Twee spelers aan het bord, onbeperkt publiek eromheen.'],
          ['Remise en opgeven', 'Remise aanbieden, aannemen of afwijzen — plus de officiële remiseregels.'],
          ['Werkt op je telefoon', 'Sleep een schijf of tik twee keer; het bord past op elk scherm.'],
        ],
        back: '← Terug naar minigames',
      }
    : {
        title: 'DAMCAFÉ — international draughts online',
        description:
          'Play international draughts (10×10) online against a friend. Compulsory capture, maximum capture, flying kings, clocks and a move list.',
        eyebrow: 'Empyr / Minigames',
        h1a: 'Twenty men.',
        h1b: 'Fifty squares.',
        blurb:
          'The Dutch game on a proper hundred-square board. The server works out every capture sequence, enforces the maximum, and lets you choose when several routes take the same number of pieces.',
        createTitle: 'New board',
        createSub: 'Open a room and pass the link on.',
        create: 'Open a board',
        joinTitle: 'Join',
        joinSub: 'Got a code from someone?',
        joinPlaceholder: 'Room code',
        join: 'Join',
        rulesTitle: 'How it goes',
        rules: [
          ['Capturing is compulsory', 'If a capture exists you have to take it. Men capture forwards and backwards.'],
          ['Take the maximum', 'Of every sequence available you must play one that takes the greatest number of pieces.'],
          ['Flying kings', 'A king runs and captures along the whole diagonal, and you pick where it lands.'],
          ['Crowned on the far row', 'Finish a move on the far row and you are a king. Merely pass through and you stay a man.'],
        ],
        featTitle: 'At the table',
        feats: [
          ['Clock with increment', 'Optional, with a per-move increment, and owned entirely by the server.'],
          ['Move list in draughts notation', 'Squares 1 to 50, × for a capture. Click back through the game and jump to live.'],
          ['Route chooser', 'Same haul by a different path? Build the route hop by hop or pick it from the list.'],
          ['Onlookers welcome', 'Two players at the board, as much of an audience as you like.'],
          ['Draws and resignation', 'Offer, accept or decline a draw — plus the official draw rules.'],
          ['Works on a phone', 'Drag a piece or tap twice; the board fits any screen.'],
        ],
        back: '← Back to minigames',
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <PortfolioSEO
      lang={lang}
      title={copy.title}
      description={copy.description}
      path="/minigames/draughts"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Azeret+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <LocaleRedirect lang={lang} />
    <style>
      :root {
        --ink: #f4e8d5;
        --dim: #bda182;
        --faint: #90755b;
        --edge: rgba(236, 205, 156, 0.14);
        --brass: #d7a13c;
        --brass-lit: #f2cd82;
        --sq-light: #e0c59a;
        --sq-dark: #7d4a29;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        overflow-x: hidden;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        font-family: 'Bricolage Grotesque', 'Trebuchet MS', system-ui, sans-serif;
        background:
          radial-gradient(120% 65% at 50% 0%, rgba(215, 161, 60, 0.12), transparent 62%),
          radial-gradient(80% 50% at 8% 100%, rgba(125, 74, 41, 0.24), transparent 68%),
          linear-gradient(180deg, #241a13 0%, #1d1611 55%, #17110d 100%);
      }

      .wrap {
        width: 100%;
        max-width: 70rem;
        margin: 0 auto;
        padding: 0 1.15rem;
      }

      header.bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.05rem 0;
        border-bottom: 1px solid var(--edge);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-weight: 800;
        font-size: 1rem;
        color: var(--ink);
        text-decoration: none;
      }
      .brand img {
        width: 1.9rem;
        height: 1.9rem;
        border-radius: 0.5rem;
        object-fit: cover;
      }
      .grow {
        flex: 1;
      }

      .lang {
        display: flex;
        gap: 0.25rem;
        padding: 0.2rem;
        border: 1px solid var(--edge);
        border-radius: 999px;
      }
      .lang a {
        padding: 0.22rem 0.65rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--dim);
        text-decoration: none;
      }
      .lang a[aria-current='true'] {
        background: linear-gradient(180deg, var(--brass-lit), var(--brass));
        color: #2a1a09;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: 2rem;
        align-items: center;
        padding: 3.4rem 0 2rem;
      }
      @media (max-width: 820px) {
        .hero {
          grid-template-columns: 1fr;
          padding-top: 2.4rem;
        }
      }

      .eyebrow {
        margin: 0;
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: var(--brass);
      }
      h1 {
        margin: 1rem 0 0;
        font-size: clamp(2.4rem, 7.5vw, 4.4rem);
        font-weight: 800;
        line-height: 0.98;
        letter-spacing: -0.035em;
      }
      h1 span {
        color: var(--faint);
      }
      .blurb {
        margin: 1.2rem 0 0;
        max-width: 32rem;
        font-size: 1rem;
        line-height: 1.62;
        color: var(--dim);
      }

      /* A little demo board, drawn in CSS so nothing has to load. */
      .demo {
        position: relative;
        width: 100%;
        max-width: 24rem;
        margin: 0 auto;
        aspect-ratio: 1;
        padding: 3.4%;
        border-radius: 0.5rem;
        background:
          repeating-linear-gradient(96deg, rgba(0, 0, 0, 0.13) 0 1px, transparent 1px 6px),
          linear-gradient(158deg, #4d3625, #3d2b1e 45%, #281b12);
        box-shadow:
          0 0 0 1px rgba(255, 226, 180, 0.09) inset,
          0 1.4rem 2.6rem -1.4rem rgba(40, 19, 8, 0.6);
      }
      .demo .grid {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        grid-template-rows: repeat(10, 1fr);
        width: 100%;
        height: 100%;
        overflow: hidden;
        border-radius: 0.15rem;
      }
      .demo i {
        position: relative;
        display: grid;
        place-items: center;
        background: linear-gradient(150deg, #ead2ac, var(--sq-light));
      }
      .demo i.d {
        background: linear-gradient(150deg, #8b5430, var(--sq-dark));
      }
      .demo i b {
        width: 76%;
        height: 76%;
        border-radius: 50%;
        display: grid;
        place-items: center;
      }
      .demo i b.w {
        background: radial-gradient(circle at 34% 26%, #fffaee 0 12%, #f3e0bd 48%, #d9bd8c 88%, #c0a173 100%);
        box-shadow: 0 0.16em 0.28em rgba(52, 25, 10, 0.5), inset 0 0.1em 0.2em rgba(255, 255, 255, 0.6);
      }
      .demo i b.z {
        background: radial-gradient(circle at 34% 26%, #6b4634 0 12%, #46291d 48%, #2a1810 88%, #1b0f0a 100%);
        box-shadow: 0 0.16em 0.28em rgba(30, 12, 4, 0.6), inset 0 0.1em 0.2em rgba(255, 214, 170, 0.2);
      }
      .demo i b.k::after {
        content: '';
        width: 45%;
        height: 45%;
        background: var(--brass);
        clip-path: polygon(0% 100%, 12% 32%, 34% 58%, 50% 8%, 66% 58%, 88% 32%, 100% 100%);
      }

      .cards {
        display: grid;
        gap: 0.85rem;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        margin-top: 2.2rem;
      }
      .card {
        border: 1px solid var(--edge);
        border-radius: 0.6rem;
        background: linear-gradient(180deg, rgba(255, 244, 226, 0.06), rgba(255, 244, 226, 0.02));
        padding: 1.2rem;
      }
      .card h2 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 800;
      }
      .card p {
        margin: 0.4rem 0 0;
        color: var(--dim);
        font-size: 0.86rem;
        line-height: 1.55;
      }

      .field {
        width: 100%;
        margin-top: 0.9rem;
        padding: 0.65rem 0.8rem;
        border-radius: 0.4rem;
        border: 1px solid var(--edge);
        background: rgba(20, 12, 7, 0.55);
        color: var(--ink);
        font-family: 'Azeret Mono', ui-monospace, monospace;
        font-size: 0.92rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .field:focus-visible {
        outline: 2px solid var(--brass-lit);
        outline-offset: 1px;
      }

      .btn {
        display: inline-block;
        margin-top: 0.7rem;
        padding: 0.62rem 1.15rem;
        border: 1px solid #b9862c;
        border-radius: 0.4rem;
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 700;
        color: #2a1a09;
        background: linear-gradient(180deg, var(--brass-lit), var(--brass));
        cursor: pointer;
        text-decoration: none;
        transition: transform 0.12s, filter 0.15s;
      }
      .btn:hover {
        transform: translateY(-1px);
        filter: brightness(1.05);
      }
      .btn:active {
        transform: translateY(1px);
      }
      .btn:focus-visible {
        outline: 2px solid var(--brass-lit);
        outline-offset: 3px;
      }
      .btn.quiet {
        color: var(--ink);
        border-color: var(--edge);
        background: transparent;
      }

      section.block {
        padding: 2.6rem 0;
        border-top: 1px solid var(--edge);
      }
      section.block h2 {
        margin: 0.7rem 0 0;
        font-size: clamp(1.55rem, 4vw, 2.1rem);
        font-weight: 800;
        letter-spacing: -0.03em;
      }

      .steps {
        display: grid;
        gap: 0.8rem;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        margin-top: 1.6rem;
        list-style: none;
        padding: 0;
      }
      .steps li {
        border-left: 2px solid var(--brass);
        padding: 0.05rem 0 0.05rem 0.85rem;
      }
      .steps b {
        display: block;
        font-size: 0.96rem;
        font-weight: 800;
      }
      .steps span {
        display: block;
        margin-top: 0.3rem;
        color: var(--dim);
        font-size: 0.85rem;
        line-height: 1.55;
      }

      .feats {
        display: grid;
        gap: 0.7rem;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        margin-top: 1.6rem;
      }
      .feat {
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: rgba(255, 244, 226, 0.035);
        padding: 0.95rem 1rem;
      }
      .feat b {
        font-size: 0.94rem;
        font-weight: 800;
      }
      .feat p {
        margin: 0.35rem 0 0;
        color: var(--dim);
        font-size: 0.82rem;
        line-height: 1.55;
      }

      footer {
        padding: 2rem 0 2.6rem;
      }
      footer a {
        color: var(--dim);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.86rem;
      }
      footer a:hover {
        color: var(--ink);
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="bar">
        <a class="brand" href={`/${lang}`}>
          <img src="/images/empyr-logo.png" alt="Empyr" width="30" height="30" />
          Empyr
        </a>
        <span class="grow"></span>
        <div class="lang">
          {
            languages.map((l) => (
              <a href={`/${l}/minigames/draughts`} aria-current={l === lang ? 'true' : 'false'}>
                {l.toUpperCase()}
              </a>
            ))
          }
        </div>
      </header>

      <div class="hero">
        <div>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1>{copy.h1a}<br /><span>{copy.h1b}</span></h1>
          <p class="blurb">{copy.blurb}</p>
        </div>
        <div class="demo" aria-hidden="true">
          <div class="grid">
            {
              Array.from({ length: 100 }, (_, index) => {
                const row = Math.floor(index / 10);
                const col = index % 10;
                const dark = (row + col) % 2 === 1;
                const square = dark ? row * 5 + Math.floor(col / 2) + 1 : 0;
                const black = [1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 13, 14, 16, 19].includes(square);
                const white = [24, 28, 31, 33, 35, 36, 38, 40, 42, 44, 45, 47, 48, 50].includes(square);
                const king = square === 28 || square === 19;
                return (
                  <i class={dark ? 'd' : ''}>
                    {black ? <b class={`z${king ? ' k' : ''}`}></b> : null}
                    {white ? <b class={`w${king ? ' k' : ''}`}></b> : null}
                  </i>
                );
              })
            }
          </div>
        </div>
      </div>

      <div class="cards">
        <div class="card">
          <h2>{copy.createTitle}</h2>
          <p>{copy.createSub}</p>
          <button class="btn" id="make">{copy.create}</button>
        </div>
        <div class="card">
          <h2>{copy.joinTitle}</h2>
          <p>{copy.joinSub}</p>
          <form id="join">
            <input class="field" id="code" maxlength="12" placeholder={copy.joinPlaceholder} required />
            <button class="btn quiet" type="submit">{copy.join}</button>
          </form>
        </div>
      </div>

      <section class="block">
        <p class="eyebrow">{copy.rulesTitle}</p>
        <h2>{copy.rulesTitle}</h2>
        <ul class="steps">
          {
            copy.rules.map(([head, text]) => (
              <li>
                <b>{head}</b>
                <span>{text}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="block">
        <p class="eyebrow">{copy.featTitle}</p>
        <h2>{copy.featTitle}</h2>
        <div class="feats">
          {
            copy.feats.map(([head, text]) => (
              <div class="feat">
                <b>{head}</b>
                <p>{text}</p>
              </div>
            ))
          }
        </div>
      </section>

      <footer>
        <a href={`/${lang}/minigames`}>{copy.back}</a>
      </footer>
    </div>

    <script is:inline define:vars={{ lang }}>
      function freshCode() {
        const alphabet = 'abcdefghjkmnpqrstuvwxyz23456789';
        const bytes = new Uint8Array(5);
        window.crypto.getRandomValues(bytes);
        return Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join('');
      }

      document.getElementById('make').addEventListener('click', () => {
        window.location.href = `/${lang}/minigames/draughts/play?code=${freshCode()}`;
      });

      document.getElementById('join').addEventListener('submit', (event) => {
        event.preventDefault();
        const raw = document.getElementById('code').value.trim().toLowerCase();
        const code = raw.replace(/[^a-z0-9-]/g, '').slice(0, 12);
        if (code) window.location.href = `/${lang}/minigames/draughts/play?code=${code}`;
      });
    </script>
  </body>
</html>
