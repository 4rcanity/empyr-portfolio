---
import { languages, type Lang } from '../../../../i18n/ui';
import PortfolioSEO from '../../../../components/shared/PortfolioSEO.astro';
import LocaleRedirect from '../../../../components/shared/LocaleRedirect.astro';
import { CELLS, NEST, TILE, TRACK_PATH } from '../../../../games/ganzenbord/board';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const copy =
  lang === 'nl'
    ? {
        title: 'Ganzenbord — multiplayer bordspel',
        description:
          'Speel het klassieke Nederlandse ganzenbord online met 2 tot 6 spelers. Twaalf ganzen, de brug, de herberg, de put, het doolhof, de gevangenis en de dood.',
        eyebrow: 'Empyr / Minigames',
        h1a: 'Twaalf ganzen,',
        h1b: 'één put.',
        blurb:
          'Het oudste bordspel van de Lage Landen, in je browser. Gooi met twee stenen, vlieg mee met de ganzen en hoop dat je vak 58 overslaat. Wie precies op 63 landt, staat in de ganzentuin.',
        createTitle: 'Nieuw bord',
        createSub: 'Open een kamer en deel de link.',
        create: 'Bord openen',
        joinTitle: 'Meedoen',
        joinSub: 'Heb je een code van iemand anders?',
        joinPlaceholder: 'Kamercode',
        join: 'Meedoen',
        rulesTitle: 'Hoe het gaat',
        rulesEyebrow: '2 tot 6 spelers',
        rules: [
          ['Twee stenen', 'Gooi, verplaats je pion en doe wat het vak zegt. De server rekent alles uit — jij hoeft alleen te gooien.'],
          ['Precies op 63', 'Gooi je te veel, dan stuiter je met het verschil terug het bord in. Alleen exact 63 wint.'],
          ['Strafvakken', 'Kom je op een strafvak, dan krijg je een uitgebreid venster te zien: welk vak, wat het doet, hoe lang het duurt en waar je pion terechtkomt.'],
          ['Regelset', 'De host kiest traditioneel of eigen huisregels. Bovenin het bord staat altijd welke variant loopt.'],
        ],
        squaresTitle: 'De vakken',
        squaresSub: 'De traditionele Nederlandse regels, precies zoals ze op het oude bord staan.',
        squares: [
          ['De gans', '5 · 9 · 14 · 18 · 23 · 27 · 32 · 36 · 41 · 45 · 50 · 54', 'Land je op een gans, dan mag je nog eens hetzelfde aantal vooruit. Land je weer op een gans, dan gaat het door.'],
          ['De brug', '6', 'De brug brengt je in één keer over naar vak 12.'],
          ['De herberg', '19', 'Je schuift aan en blijft zitten. Standaard sla je twee beurten over.'],
          ['De put', '31', 'Je valt erin en blijft staan tot een andere speler precies op 31 landt en jouw plek inneemt.'],
          ['Het doolhof', '42', 'Je verdwaalt en wordt teruggezet naar vak 39.'],
          ['De gevangenis', '52', 'Vast tot je wordt afgelost, net als de put.'],
          ['De dood', '58', 'Vijf vakken voor de finish gaat alles weg: terug naar het nest.'],
        ],
        openingTitle: 'De openingsworp',
        openingBody:
          'Gooi je bij je eerste worp een negen met 3 en 6, dan ga je meteen naar vak 26. Met 4 en 5 vlieg je door naar vak 53. Beide regels staan aan in de traditionele set en kunnen uit.',
        back: '← Terug naar minigames',
        preview: 'Het bord: 63 vakken in een spiraal naar binnen.',
      }
    : {
        title: 'Ganzenbord — multiplayer board game',
        description:
          'Play the classic Dutch Game of the Goose online with 2 to 6 players. Twelve geese, the bridge, the inn, the well, the maze, the prison and death.',
        eyebrow: 'Empyr / Minigames',
        h1a: 'Twelve geese,',
        h1b: 'one well.',
        blurb:
          'The oldest board game of the Low Countries, in your browser. Throw two dice, ride the geese, and hope you step over square 58. Land exactly on 63 and the goose garden is yours.',
        createTitle: 'New board',
        createSub: 'Open a room and share the link.',
        create: 'Open a board',
        joinTitle: 'Join',
        joinSub: 'Got a code from somebody else?',
        joinPlaceholder: 'Room code',
        join: 'Join',
        rulesTitle: 'How it goes',
        rulesEyebrow: '2 to 6 players',
        rules: [
          ['Two dice', 'Throw, move your pawn, and do what the square says. The server resolves every rule — you only have to throw.'],
          ['Exactly 63', 'Overshoot and you bounce back into the board by the excess. Only an exact 63 wins.'],
          ['Penalty squares', 'Land on a penalty square and a full window opens: which square it is, what it does, how long it lasts and where your pawn ends up.'],
          ['Rule set', 'The host picks traditional or their own house rules. The board always states which variant is running.'],
        ],
        squaresTitle: 'The squares',
        squaresSub: 'The traditional Dutch rules, exactly as the old board prints them.',
        squares: [
          ['The goose', '5 · 9 · 14 · 18 · 23 · 27 · 32 · 36 · 41 · 45 · 50 · 54', 'Land on a goose and you move forward again by the same throw. Land on another goose and it keeps going.'],
          ['The bridge', '6', 'The bridge carries you straight across to square 12.'],
          ['The inn', '19', 'You pull up a chair and stay. Two turns lost by default.'],
          ['The well', '31', 'In you go, and there you stay until another player lands exactly on 31 and takes your place.'],
          ['The maze', '42', 'You get lost and are set back to square 39.'],
          ['The prison', '52', 'Held until you are relieved, exactly like the well.'],
          ['Death', '58', 'Five squares from the finish everything is undone: back to the nest.'],
        ],
        openingTitle: 'The opening throw',
        openingBody:
          'Throw a nine on your first turn as 3 and 6 and you run straight to square 26. As 4 and 5 you fly on to square 53. Both are on in the traditional set, and both can be switched off.',
        back: '← Back to minigames',
        preview: 'The board: 63 squares coiling inward.',
      };

const SPECIAL = new Set(CELLS.filter((cell) => cell.kind !== 'plain').map((cell) => cell.n));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <PortfolioSEO
      lang={lang}
      title={copy.title}
      description={copy.description}
      path="/minigames/ganzenbord"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <LocaleRedirect lang={lang} />
    <style>
      :root {
        --ink: #241a0f;
        --ink-soft: #4c3c28;
        --ink-dim: #7a6647;
        --accent: #a5341c;
        --accent-hi: #c84a2c;
        --rule: rgba(58, 42, 24, 0.24);
        --edge: #c0a675;
        --shade-1: 0 1px 0 rgba(255, 248, 230, 0.5), 0 2px 6px rgba(92, 66, 36, 0.16);
        --shade-2: 0 2px 0 rgba(255, 248, 230, 0.4), 0 12px 30px rgba(92, 66, 36, 0.24);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        color: var(--ink);
        font-family: 'EB Garamond', 'Iowan Old Style', Georgia, serif;
        font-size: 17px;
        line-height: 1.6;
        font-variant-numeric: tabular-nums;
        background-color: #dcc9a3;
        background-image:
          radial-gradient(120% 80% at 12% 0%, rgba(255, 250, 235, 0.75), transparent 62%),
          radial-gradient(90% 70% at 92% 12%, rgba(196, 160, 108, 0.45), transparent 60%),
          radial-gradient(140% 110% at 50% 110%, rgba(120, 88, 50, 0.35), transparent 65%),
          repeating-linear-gradient(101deg, rgba(126, 96, 58, 0.05) 0 2px, transparent 2px 5px),
          repeating-linear-gradient(7deg, rgba(126, 96, 58, 0.045) 0 3px, transparent 3px 7px);
      }

      .wrap {
        width: 100%;
        max-width: 74rem;
        margin: 0 auto;
        padding: 0 clamp(0.9rem, 3vw, 1.5rem);
      }

      header.bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--rule);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--ink);
        text-decoration: none;
        font-family: 'Cinzel', serif;
        font-weight: 600;
        letter-spacing: 0.1em;
        font-size: 0.95rem;
      }

      .brand img {
        width: 2rem;
        height: 2rem;
        border-radius: 0.4rem;
        object-fit: cover;
      }

      .brand:focus-visible,
      .lang a:focus-visible,
      footer a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .grow {
        flex: 1;
      }

      .lang {
        display: flex;
        gap: 0.2rem;
        padding: 0.15rem;
        border: 1px solid var(--rule);
        border-radius: 999px;
        background: rgba(255, 250, 236, 0.5);
      }

      .lang a {
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        font-family: 'Cinzel', serif;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        color: var(--ink-dim);
        text-decoration: none;
      }

      .lang a[aria-current='true'] {
        background: var(--accent);
        color: #fdf3e2;
      }

      .hero {
        display: grid;
        gap: clamp(1.5rem, 4vw, 3rem);
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        align-items: center;
        padding: clamp(2rem, 6vw, 4rem) 0 2.5rem;
      }

      .eyebrow {
        margin: 0;
        font-family: 'Cinzel', serif;
        font-size: 0.7rem;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: var(--accent);
      }

      h1 {
        margin: 1rem 0 0;
        font-family: 'Cinzel', serif;
        font-size: clamp(2.3rem, 7vw, 4.2rem);
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.01em;
      }

      h1 span {
        color: var(--accent);
      }

      .blurb {
        margin: 1.2rem 0 0;
        max-width: 34rem;
        color: var(--ink-soft);
      }

      figure.preview {
        margin: 0;
        padding: 0.5rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: linear-gradient(180deg, #d9c39a, #c8ae80);
        box-shadow: var(--shade-2);
      }

      figure.preview svg {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0.3rem;
        border: 1px solid rgba(70, 50, 28, 0.35);
      }

      figure.preview figcaption {
        padding: 0.45rem 0.2rem 0.1rem;
        font-size: 0.76rem;
        font-style: italic;
        color: #45301a;
      }

      .cards {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
        margin-top: 2rem;
      }

      .card {
        padding: 1.3rem 1.4rem 1.5rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background:
          linear-gradient(180deg, rgba(255, 251, 240, 0.75), rgba(240, 228, 202, 0.62)),
          repeating-linear-gradient(94deg, rgba(126, 96, 58, 0.05) 0 2px, transparent 2px 6px);
        box-shadow: var(--shade-1);
      }

      .card h2 {
        margin: 0;
        font-family: 'Cinzel', serif;
        font-size: 1.15rem;
        font-weight: 600;
        letter-spacing: 0.06em;
      }

      .card p {
        margin: 0.4rem 0 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      .field {
        width: 100%;
        margin-top: 0.9rem;
        padding: 0.7rem 0.85rem;
        border: 1px solid var(--rule);
        border-radius: 0.35rem;
        background: rgba(255, 252, 244, 0.8);
        box-shadow: inset 0 1px 3px rgba(92, 66, 36, 0.28);
        color: var(--ink);
        font-family: inherit;
        font-size: 1rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .field:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 0.8rem;
        padding: 0.62rem 1.2rem;
        border: 1px solid var(--rule);
        border-radius: 0.35rem;
        background: linear-gradient(180deg, #fbf1da, #e4d2ac);
        color: var(--ink);
        font-family: 'Cinzel', serif;
        font-size: 0.88rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        box-shadow: var(--shade-1);
        transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
        filter: brightness(1.04);
        box-shadow: var(--shade-2);
      }

      .btn:active {
        transform: translateY(1px);
        box-shadow: inset 0 1px 3px rgba(92, 66, 36, 0.28);
      }

      .btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .btn.accent {
        background: linear-gradient(180deg, var(--accent-hi), var(--accent));
        color: #fdf3e2;
        border-color: rgba(60, 24, 12, 0.5);
      }

      section.block {
        padding: 2.6rem 0;
        border-top: 1px solid var(--rule);
      }

      section.block h2 {
        margin: 0.7rem 0 0;
        font-family: 'Cinzel', serif;
        font-size: clamp(1.6rem, 4vw, 2.3rem);
        font-weight: 600;
        letter-spacing: 0.01em;
      }

      section.block > p {
        margin: 0.6rem 0 0;
        max-width: 36rem;
        color: var(--ink-soft);
      }

      .steps {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        margin: 1.8rem 0 0;
        padding: 0;
        list-style: none;
      }

      .steps li {
        padding-left: 1rem;
        border-left: 2px solid var(--accent);
      }

      .steps b {
        display: block;
        font-family: 'Cinzel', serif;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
      }

      .steps span {
        display: block;
        margin-top: 0.3rem;
        color: var(--ink-soft);
        font-size: 0.92rem;
      }

      table.squares {
        width: 100%;
        margin-top: 1.6rem;
        border-collapse: collapse;
        font-size: 0.95rem;
      }

      table.squares th,
      table.squares td {
        padding: 0.6rem 0.5rem;
        border-bottom: 1px solid var(--rule);
        text-align: left;
        vertical-align: top;
      }

      table.squares th {
        font-family: 'Cinzel', serif;
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-dim);
        font-weight: 600;
      }

      table.squares td:first-child {
        font-family: 'Cinzel', serif;
        white-space: nowrap;
      }

      table.squares td:nth-child(2) {
        color: var(--accent);
        white-space: nowrap;
        font-size: 0.85rem;
      }

      table.squares td:last-child {
        color: var(--ink-soft);
      }

      .note {
        margin-top: 1.4rem;
        padding: 1rem 1.2rem;
        border: 1px solid var(--rule);
        border-left: 4px solid var(--accent);
        border-radius: 0.35rem;
        background: rgba(255, 250, 236, 0.5);
      }

      .note b {
        display: block;
        font-family: 'Cinzel', serif;
        letter-spacing: 0.06em;
      }

      .note p {
        margin: 0.35rem 0 0;
        color: var(--ink-soft);
      }

      footer {
        padding: 2rem 0 3rem;
        border-top: 1px solid var(--rule);
      }

      footer a {
        color: var(--ink-dim);
        text-decoration: none;
        font-size: 0.9rem;
      }

      footer a:hover {
        color: var(--ink);
      }

      /* preview board */
      .pv-paper {
        fill: #ecdcbb;
      }

      .pv-track {
        fill: none;
        stroke: rgba(250, 242, 224, 0.6);
        stroke-width: 6.4;
        stroke-linecap: round;
      }

      .pv-track-under {
        fill: none;
        stroke: rgba(74, 54, 30, 0.24);
        stroke-width: 7.6;
        stroke-linecap: round;
      }

      .pv-face {
        fill: rgba(252, 246, 230, 0.85);
        stroke: rgba(58, 42, 24, 0.55);
        stroke-width: 0.28;
      }

      .pv-face.special {
        fill: rgba(244, 226, 176, 0.95);
        stroke: rgba(140, 44, 22, 0.7);
        stroke-width: 0.36;
      }

      .pv-nest {
        fill: rgba(250, 240, 216, 0.9);
        stroke: rgba(58, 42, 24, 0.5);
        stroke-width: 0.3;
        stroke-dasharray: 1.2 0.8;
      }

      .pv-num {
        fill: #3a2a18;
        font-family: 'Cinzel', serif;
        font-size: 2.3px;
        text-anchor: middle;
        dominant-baseline: middle;
      }

      @media (max-width: 820px) {
        .hero {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      @media (max-width: 640px) {
        table.squares {
          display: block;
          font-size: 0.92rem;
        }

        table.squares thead {
          display: none;
        }

        table.squares tbody,
        table.squares tr {
          display: block;
        }

        table.squares tr {
          padding: 0.6rem 0;
          border-bottom: 1px solid var(--rule);
        }

        table.squares td {
          display: block;
          padding: 0;
          border: none;
        }

        table.squares td:nth-child(2) {
          white-space: normal;
          margin-top: 0.15rem;
        }

        table.squares td:last-child {
          margin-top: 0.25rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="bar">
        <a class="brand" href={`/${lang}`}>
          <img src="/images/empyr-logo.png" alt="Empyr" width="32" height="32" />
          Empyr
        </a>
        <span class="grow"></span>
        <div class="lang">
          {languages.map((l) => (
            <a href={`/${l}/minigames/ganzenbord`} aria-current={l === lang ? 'true' : 'false'}>
              {l.toUpperCase()}
            </a>
          ))}
        </div>
      </header>

      <div class="hero">
        <div>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1>{copy.h1a}<br /><span>{copy.h1b}</span></h1>
          <p class="blurb">{copy.blurb}</p>

          <div class="cards">
            <div class="card">
              <h2>{copy.createTitle}</h2>
              <p>{copy.createSub}</p>
              <button class="btn accent" id="make">{copy.create}</button>
            </div>
            <div class="card">
              <h2>{copy.joinTitle}</h2>
              <p>{copy.joinSub}</p>
              <form id="join">
                <input class="field" id="code" maxlength="12" placeholder={copy.joinPlaceholder} required />
                <button class="btn" type="submit">{copy.join}</button>
              </form>
            </div>
          </div>
        </div>

        <figure class="preview">
          <svg viewBox="0 0 100 100" role="img" aria-label={copy.preview}>
            <rect x="0" y="0" width="100" height="100" class="pv-paper" />
            <path d={TRACK_PATH} class="pv-track-under" />
            <path d={TRACK_PATH} class="pv-track" />
            <circle cx={NEST.x} cy={NEST.y} r={TILE * 0.66} class="pv-nest" />
            {CELLS.map((cell) => (
              <g transform={`translate(${cell.x.toFixed(2)} ${cell.y.toFixed(2)})`}>
                <g transform={`rotate(${cell.angle.toFixed(1)})`}>
                  <rect
                    x={-TILE / 2}
                    y={-TILE / 2}
                    width={TILE}
                    height={TILE}
                    rx="0.7"
                    class={SPECIAL.has(cell.n) ? 'pv-face special' : 'pv-face'}
                  />
                </g>
                <text class="pv-num" y="0.9">{cell.n}</text>
              </g>
            ))}
          </svg>
          <figcaption>{copy.preview}</figcaption>
        </figure>
      </div>

      <section class="block">
        <p class="eyebrow">{copy.rulesEyebrow}</p>
        <h2>{copy.rulesTitle}</h2>
        <ul class="steps">
          {copy.rules.map(([head, text]) => (
            <li>
              <b>{head}</b>
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="block">
        <p class="eyebrow">63</p>
        <h2>{copy.squaresTitle}</h2>
        <p>{copy.squaresSub}</p>
        <table class="squares">
          <thead>
            <tr>
              <th>{lang === 'nl' ? 'Vak' : 'Square'}</th>
              <th>{lang === 'nl' ? 'Nummer' : 'Number'}</th>
              <th>{lang === 'nl' ? 'Wat het doet' : 'What it does'}</th>
            </tr>
          </thead>
          <tbody>
            {copy.squares.map(([name, numbers, what]) => (
              <tr>
                <td>{name}</td>
                <td>{numbers}</td>
                <td>{what}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="note">
          <b>{copy.openingTitle}</b>
          <p>{copy.openingBody}</p>
        </div>
      </section>

      <footer>
        <a href={`/${lang}/minigames`}>{copy.back}</a>
      </footer>
    </div>

    <script is:inline define:vars={{ lang }}>
      function freshCode() {
        const alphabet = 'abcdefghjkmnpqrstuvwxyz23456789';
        const bytes = new Uint8Array(5);
        window.crypto.getRandomValues(bytes);
        return Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join('');
      }

      document.getElementById('make').addEventListener('click', () => {
        window.location.href = `/${lang}/minigames/ganzenbord/play?code=${freshCode()}`;
      });

      document.getElementById('join').addEventListener('submit', (event) => {
        event.preventDefault();
        const raw = document.getElementById('code').value.trim().toLowerCase();
        const code = raw.replace(/[^a-z0-9-]/g, '').slice(0, 12);
        if (code) window.location.href = `/${lang}/minigames/ganzenbord/play?code=${code}`;
      });
    </script>
  </body>
</html>
