---
import { languages, type Lang } from '../../../../i18n/ui';
import PortfolioSEO from '../../../../components/shared/PortfolioSEO.astro';
import LocaleRedirect from '../../../../components/shared/LocaleRedirect.astro';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const copy =
  lang === 'nl'
    ? {
        title: "Liar's Bar — Empyr Minigames",
        description:
          'Bluf kaarten in een achterkamertafel. Roep leugenaar, trek de trekker — wie overleeft wint.',
        eyebrow: 'Empyr / Minigames',
        h1a: 'Achterkamer.',
        h1b: 'Geen eerlijk spel.',
        blurb:
          'Speel koning, vrouw of aas op de tafelkaart — of bluf en hoop dat niemand het merkt. Roep leugenaar en iemand trekt de trekker. Laatste overlevende pakt de pot.',
        createTitle: 'Nieuwe tafel',
        createSub: 'Open een kamer en stuur de link naar je vrienden.',
        create: 'Tafel openen',
        joinTitle: 'Meedoen',
        joinSub: 'Heb je een code gekregen?',
        joinPlaceholder: 'Kamercode',
        join: 'Meedoen',
        rulesTitle: 'Hoe het werkt',
        rules: [
          ['Tafelkaart', 'Elke ronde draait om koning, vrouw of aas. Jokers tellen mee als wild.'],
          ['Bluffen', 'Leg tot drie kaarten neer en claim dat het de tafelkaart is — niemand ziet je hand.'],
          ['Leugenaar', 'Aan jouw beurt kun je de vorige speler uitdagen. Liegen betekent trekken.'],
          ['Revolver', 'Elke speler heeft een cilinder met één live patroon. Klik en je leeft — knal en je ligt eruit.'],
        ],
        back: '← Terug naar minigames',
      }
    : {
        title: "Liar's Bar — Empyr Minigames",
        description:
          'Bluff cards in a back-room table. Call liar, pull the trigger — last one standing wins.',
        eyebrow: 'Empyr / Minigames',
        h1a: 'Back room.',
        h1b: 'No fair play.',
        blurb:
          'Play kings, queens or aces to match the table card — or bluff and pray nobody notices. Call liar and somebody pulls the trigger. Last survivor takes the pot.',
        createTitle: 'New table',
        createSub: 'Open a room and send the link to your friends.',
        create: 'Open a table',
        joinTitle: 'Join',
        joinSub: 'Got a code from someone?',
        joinPlaceholder: 'Room code',
        join: 'Join',
        rulesTitle: 'How it runs',
        rules: [
          ['Table card', 'Each round revolves around king, queen or ace. Jokers count as wild.'],
          ['Bluff', 'Lay up to three cards and claim they match — nobody sees your hand.'],
          ['Call liar', 'On your turn you can challenge the last claim. Lies mean pulling the trigger.'],
          ['Revolver', 'Every player loads one live round in their cylinder. Click and live — bang and you are out.'],
        ],
        back: '← Back to minigames',
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <PortfolioSEO lang={lang} title={copy.title} description={copy.description} path="/minigames/liars" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <LocaleRedirect lang={lang} />
    <style>
      :root {
        --felt: #1c2b22;
        --felt-edge: #0f1a14;
        --wood: #2a1810;
        --brass: #c8a253;
        --brass-dim: #8a6f3c;
        --parchment: #ece6da;
        --ink: #12100c;
        --line: rgba(236, 230, 218, 0.11);
        --line-strong: rgba(236, 230, 218, 0.22);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--parchment);
        font-family: 'IBM Plex Sans', system-ui, sans-serif;
        line-height: 1.6;
        background:
          radial-gradient(120% 80% at 50% -10%, rgba(200, 162, 83, 0.1), transparent 62%),
          radial-gradient(80% 60% at 10% 108%, rgba(28, 43, 34, 0.5), transparent 66%),
          var(--ink);
      }

      .wrap {
        width: 100%;
        max-width: 68rem;
        margin: 0 auto;
        padding: 0 clamp(1rem, 4vw, 1.75rem);
      }

      header.bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--line);
      }

      .brand {
        font-family: 'Spectral', Georgia, serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--parchment);
        text-decoration: none;
      }

      .grow { flex: 1; }

      .lang {
        display: flex;
        gap: 0.2rem;
        padding: 0.15rem;
        border: 1px solid var(--line);
        border-radius: 999px;
      }

      .lang a {
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        color: rgba(236, 230, 218, 0.55);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-decoration: none;
      }

      .lang a[aria-current='true'] {
        background: var(--brass);
        color: var(--ink);
      }

      .hero {
        padding: 3.5rem 0 2rem;
        max-width: 38rem;
      }

      .eyebrow {
        margin: 0;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--brass);
      }

      h1 {
        margin: 1rem 0 0;
        font-family: 'Spectral', Georgia, serif;
        font-size: clamp(2.5rem, 7vw, 4rem);
        font-weight: 500;
        line-height: 1.02;
      }

      h1 span { color: var(--brass); }

      .blurb {
        margin: 1.3rem 0 0;
        color: rgba(236, 230, 218, 0.65);
      }

      .cards {
        display: grid;
        gap: 0.85rem;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        margin-top: 2rem;
      }

      .card {
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        padding: 1.1rem 1.15rem 1.25rem;
        background: linear-gradient(180deg, rgba(236, 230, 218, 0.045), rgba(236, 230, 218, 0.012)), var(--felt);
      }

      .card h2 {
        margin: 0;
        font-family: 'Spectral', Georgia, serif;
        font-size: 1.15rem;
        font-weight: 500;
      }

      .card p {
        margin: 0.35rem 0 0;
        color: rgba(236, 230, 218, 0.6);
        font-size: 0.86rem;
      }

      .field {
        width: 100%;
        margin-top: 0.85rem;
        padding: 0.6rem 0.75rem;
        border: 1px solid var(--line-strong);
        border-radius: 0.3rem;
        background: rgba(18, 16, 12, 0.5);
        color: var(--parchment);
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-size: 0.9rem;
        letter-spacing: 0.1em;
        text-transform: lowercase;
      }

      .btn {
        display: inline-block;
        margin-top: 0.75rem;
        padding: 0.55rem 1.05rem;
        border: 1px solid var(--line-strong);
        border-radius: 0.3rem;
        background: linear-gradient(180deg, rgba(236, 230, 218, 0.08), rgba(236, 230, 218, 0.02));
        color: var(--parchment);
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
      }

      .btn.go {
        border-color: rgba(200, 162, 83, 0.6);
        background: linear-gradient(180deg, #d8b264, #b98f3f);
        color: var(--ink);
        font-weight: 600;
      }

      section.block {
        padding: 2.75rem 0;
        border-top: 1px solid var(--line);
      }

      .steps {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        margin: 1.75rem 0 0;
        padding: 0;
        list-style: none;
      }

      .steps li {
        padding-left: 0.9rem;
        border-left: 1px solid var(--brass);
      }

      .steps b { display: block; font-size: 0.95rem; }

      .steps span {
        display: block;
        margin-top: 0.25rem;
        color: rgba(236, 230, 218, 0.6);
        font-size: 0.84rem;
      }

      footer { padding: 2rem 0 3rem; }

      footer a {
        color: rgba(236, 230, 218, 0.55);
        font-size: 0.85rem;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="bar">
        <a class="brand" href={`/${lang}`}>Empyr</a>
        <span class="grow"></span>
        <div class="lang">
          {languages.map((l) => (
            <a href={`/${l}/minigames/liars`} aria-current={l === lang ? 'true' : 'false'}>{l.toUpperCase()}</a>
          ))}
        </div>
      </header>

      <div class="hero">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.h1a}<br /><span>{copy.h1b}</span></h1>
        <p class="blurb">{copy.blurb}</p>
      </div>

      <div class="cards">
        <div class="card">
          <h2>{copy.createTitle}</h2>
          <p>{copy.createSub}</p>
          <button class="btn go" id="make">{copy.create}</button>
        </div>
        <div class="card">
          <h2>{copy.joinTitle}</h2>
          <p>{copy.joinSub}</p>
          <form id="join">
            <input class="field" id="code" maxlength="12" placeholder={copy.joinPlaceholder} required />
            <button class="btn" type="submit">{copy.join}</button>
          </form>
        </div>
      </div>

      <section class="block">
        <p class="eyebrow">{copy.rulesTitle}</p>
        <ul class="steps">
          {copy.rules.map(([head, text]) => (
            <li>
              <b>{head}</b>
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </section>

      <footer>
        <a href={`/${lang}/minigames`}>{copy.back}</a>
      </footer>
    </div>

    <script is:inline define:vars={{ lang }}>
      function freshCode() {
        const alphabet = 'abcdefghjkmnpqrstuvwxyz23456789';
        const bytes = new Uint8Array(5);
        window.crypto.getRandomValues(bytes);
        return Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join('');
      }

      document.getElementById('make').addEventListener('click', () => {
        window.location.href = `/${lang}/minigames/liars/play?code=${freshCode()}`;
      });

      document.getElementById('join').addEventListener('submit', (event) => {
        event.preventDefault();
        const raw = document.getElementById('code').value.trim().toLowerCase();
        const code = raw.replace(/[^a-z0-9-]/g, '').slice(0, 12);
        if (code) window.location.href = `/${lang}/minigames/liars/play?code=${code}`;
      });
    </script>
  </body>
</html>
