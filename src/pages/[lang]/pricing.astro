---
import PortfolioLayout from '../../components/portfolio/PortfolioLayout.astro';
import AllPricing from '../../components/shared/AllPricing.astro';
import { languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const copy =
  lang === 'nl'
    ? {
        eyebrow: 'Tarieven',
        heading: 'Wat het kost. Gewoon op een rij.',
        body: 'Websites, apps, Roblox en muziek. Kies een categorie en vink aan wat je nodig hebt.',
        ctaHeading: 'Twijfel je over de prijs?',
        ctaButton: 'App ons even',
      }
    : {
        eyebrow: 'Prices',
        heading: 'What it costs. Written down.',
        body: 'Websites, apps, Roblox and music. Pick a category and tick what you need.',
        ctaHeading: 'Not sure about the price?',
        ctaButton: 'WhatsApp us',
      };

const pageTitle = lang === 'nl' ? 'Tarieven — Empyr Studios' : 'Prices — Empyr Studios';
const pageDescription =
  lang === 'nl'
    ? 'Tarieven van Empyr Studios — websites, apps, Roblox en muziek. Kies een categorie en tel het bij elkaar op.'
    : 'Prices from Empyr Studios — websites, apps, Roblox and music. Pick a category and add it up.';
---

<PortfolioLayout
  lang={lang}
  current="pricing"
  title={pageTitle}
  description={pageDescription}
  path="/pricing"
>
  <!-- Page header -->
  <section class="relative isolate overflow-hidden py-20 text-center">
    <div class="pointer-events-none absolute left-1/2 top-[-12rem] h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-orange-500/20 blur-[120px]"></div>

    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 rounded-full border border-orange-400/20 bg-orange-400/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.22em] text-orange-300">
        <span class="h-1.5 w-1.5 rounded-full bg-orange-400 shadow-[0_0_12px_#fb923c]"></span>
        {copy.eyebrow}
      </span>
      <h1 class="mt-7 text-4xl font-semibold leading-[1.05] tracking-[-0.05em] text-(--heading) sm:text-5xl lg:text-6xl">
        {copy.heading}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-(--muted) sm:text-lg">{copy.body}</p>
    </div>
  </section>

  <AllPricing lang={lang} />

  <!-- Bottom CTA -->
  <section class="py-20 text-center">
    <div class="mx-auto max-w-2xl px-4 sm:px-6">
      <h2 class="text-3xl font-semibold tracking-[-0.05em] text-(--heading) sm:text-4xl">{copy.ctaHeading}</h2>
      <a
        href={`/${lang}/#contact`}
        class="mt-10 inline-flex items-center justify-center rounded-full bg-orange-500 px-8 py-3.5 text-sm font-bold text-white transition hover:bg-orange-400"
      >
        {copy.ctaButton}
      </a>
    </div>
  </section>
</PortfolioLayout>
