---
import Page from '../../../templates/maashaven-schade/Page.astro';
import { maashavenSchadeConfig } from '../../../data/maashaven-schade-config';
import { languages, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<Page config={maashavenSchadeConfig} lang={lang} />
