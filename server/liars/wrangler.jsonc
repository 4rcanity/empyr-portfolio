{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "empyr-liars",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "LIARS_ROOM", "class_name": "LiarsRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiarsRoom"] }]
}
