{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "empyr-ganzenbord",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "GOOSE_ROOM", "class_name": "GooseRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GooseRoom"] }]
}
